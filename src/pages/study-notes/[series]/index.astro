---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StudyModuleLinks from '../../../components/StudyModuleLinks.astro';
import { getPublicStudyNotes, getStudyModuleSummaries, studySeries } from '../../../lib/study';
export async function getStaticPaths() {
  const posts = await getPublicStudyNotes();
  return Object.entries(studySeries).filter(([name]) => posts.some((post) => post.data.series === name)).map(([name, info]) => ({ params: { series: info.slug }, props: { info, posts: posts.filter((post) => post.data.series === name), name } }));
}
const { info, posts, name } = Astro.props;
const modules = getStudyModuleSummaries(posts);
---
<BaseLayout title={info.title} description={info.description}>
  <header class="page-intro"><a class="text-link" href="/study-notes/">学习笔记 →</a><p class="eyebrow">考研复习 · {name}</p><h1>{info.title}</h1><p>{info.description}</p></header>
  <p class="study-status">{posts.length} 篇公开笔记 · 选择模块，按考纲顺序复习。</p>
  <StudyModuleLinks modules={modules} />
  <p class="home-about-links"><a class="text-link" href={`/blog/?category=Study%20Notes&series=${encodeURIComponent(name)}`}>在归档中筛选本系列 →</a></p>
</BaseLayout>
