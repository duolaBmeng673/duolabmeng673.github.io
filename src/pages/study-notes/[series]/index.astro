---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublicStudyNotes, getStudyChapters, getStudyHref, studySeries } from '../../../lib/study';
export async function getStaticPaths() {
  const posts = await getPublicStudyNotes();
  return Object.entries(studySeries).filter(([name]) => posts.some((post) => post.data.series === name)).map(([name, info]) => ({ params: { series: info.slug }, props: { info, posts: posts.filter((post) => post.data.series === name), name } }));
}
const { info, posts, name } = Astro.props;
const chapters = getStudyChapters(posts);
---
<BaseLayout title={info.title} description={info.description}>
  <header class="page-intro"><a class="text-link" href="/study-notes/">Study Notes →</a><p class="eyebrow">考研复习 · {name}</p><h1>{info.title}</h1><p>{info.description}</p></header>
  <p class="study-status">{posts.length} 篇公开笔记 · 仅列出已有内容的章节，不代表完整考纲或复习完成度。查找标题与问题可使用页首搜索。</p>
  <div class="study-chapters">{chapters.map((chapter) => <section class="study-chapter"><header><span class="chapter-code">{chapter.code}</span><h2><a href={`/study-notes/${info.slug}/chapter/${chapter.code}/`}>{chapter.title}</a></h2></header><ol class="study-note-list">{chapter.posts.map((post) => <li><a href={getStudyHref(post)}><span class="chapter-code">{post.data.syllabusSection ?? chapter.code}</span><span><strong>{post.data.title}</strong><small>{post.data.description}</small></span><span aria-hidden="true">→</span></a></li>)}</ol></section>)}</div>
  <p class="home-about-links"><a class="text-link" href={`/blog/?category=Study%20Notes&series=${encodeURIComponent(name)}`}>在 Notes 中筛选本系列 →</a></p>
</BaseLayout>
