---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CountUp from '../../../components/CountUp.astro';
import StudyModuleLinks from '../../../components/StudyModuleLinks.astro';
import { getPublicStudyNotes, getStudyModuleSummaries, studySeries } from '../../../lib/study';
export async function getStaticPaths() {
  const posts = await getPublicStudyNotes();
  return Object.entries(studySeries).filter(([name]) => posts.some((post) => post.data.series === name)).map(([name, info]) => ({ params: { series: info.slug }, props: { info, posts: posts.filter((post) => post.data.series === name), name } }));
}
const { info, posts } = Astro.props;
const modules = getStudyModuleSummaries(posts);
const moduleNames = modules.map((module) => module.title);
const moduleSummary = moduleNames.length > 1
  ? `${moduleNames.slice(0, -1).join('、')}与${moduleNames.at(-1)}`
  : (moduleNames[0] ?? '专题');
const seriesDescription = `${info.description}包含${moduleSummary}等 ${modules.length} 个专题模块。`;
---
<BaseLayout title={info.title} description={seriesDescription}>
  <header class="page-intro page-masthead">
    <div>
      <a class="back-link" href="/study-notes/">← 学习笔记</a>
      <h1>{info.title}</h1>
      <p>{seriesDescription}</p>
    </div>
    <div class="masthead-stats is-rail" aria-label="系列统计">
      <div class="masthead-rail-item is-total" data-countup-hover-zone>
        <span class="masthead-stat-label">公开笔记</span>
        <span class="masthead-rail-value">
          <CountUp to={posts.length} delay={0} />
          <span class="masthead-rail-unit">篇</span>
        </span>
      </div>
      <div class="masthead-rail-item" data-countup-hover-zone>
        <span class="masthead-stat-label">核心模块</span>
        <CountUp to={modules.length} delay={0.08} />
      </div>
    </div>
  </header>
  <p class="study-status">{posts.length} 篇公开笔记 · 选择模块，按考纲顺序复习。</p>
  <StudyModuleLinks modules={modules} />
</BaseLayout>
