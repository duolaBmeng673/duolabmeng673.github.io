---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getPublicStudyNotes, getStudyChapters, getStudyHref, studySeries } from '../../../../lib/study';
export async function getStaticPaths() {
  const posts = await getPublicStudyNotes();
  return Object.entries(studySeries).flatMap(([name, info]) => getStudyChapters(posts.filter((post) => post.data.series === name)).map((chapter) => ({ params: { series: info.slug, chapter: chapter.key }, props: { info, chapter } })));
}
const { info, chapter } = Astro.props;
---
<BaseLayout title={`${chapter.subject} · ${chapter.code} ${chapter.title} · ${info.title}`} description={`${chapter.subject}：${chapter.title}的已有学习笔记。`}>
  <header class="page-intro"><a class="text-link" href={`/study-notes/${info.slug}/`}>← {info.title}</a><p class="eyebrow">{chapter.subject} · 考纲章节 {chapter.code}</p><h1>{chapter.title}</h1><p>{chapter.posts.length} 篇公开笔记 · 按考纲顺序浏览</p></header>
  <ol class="study-note-list">{chapter.posts.map((post) => <li><a href={getStudyHref(post)}><span class="chapter-code">{post.data.syllabusSection ?? chapter.code}</span><span><strong>{post.data.title}</strong><small>{post.data.description}</small></span><span aria-hidden="true">→</span></a></li>)}</ol>
</BaseLayout>
