---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudyModuleLinks from '../../components/StudyModuleLinks.astro';
import { getPublicStudyNotes, studySeries, getStudyModuleSummaries } from '../../lib/study';
const posts = await getPublicStudyNotes();
const series = Object.entries(studySeries).filter(([name]) => posts.some((post) => post.data.series === name));
const modules = getStudyModuleSummaries(posts);
---
<BaseLayout title="学习笔记" description="课程笔记、考研复习与系统化学习资料。">
  <header class="page-intro"><p class="eyebrow">学习笔记</p><h1>学习笔记</h1><p>课程笔记、考研复习与系统化学习资料。</p></header>
  {series.map(([name, info]) => <section class="study-series-group" aria-label={info.title}><h2 class="study-series-heading"><a href={`/study-notes/${info.slug}/`}>{info.title} →</a></h2><StudyModuleLinks modules={modules.filter((module) => module.series === name)} headingLevel="h3" /></section>)}
  <p class="study-status">公开笔记数量不代表复习完成进度。</p>
  <p class="home-about-links"><a class="text-link" href="/blog/?category=Study%20Notes">在归档中筛选 →</a></p>
</BaseLayout>
