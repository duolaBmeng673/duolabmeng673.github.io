---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudyModuleLinks from '../../components/StudyModuleLinks.astro';
import CountUp from '../../components/CountUp.astro';
import { getPublicStudyNotes, studySeries, getStudyModuleSummaries } from '../../lib/study';
const posts = await getPublicStudyNotes();
const series = Object.entries(studySeries).filter(([name]) => posts.some((post) => post.data.series === name));
const modules = getStudyModuleSummaries(posts);
const moduleNames = modules.map((module) => module.title);
const moduleSummary = moduleNames.length > 1
  ? `${moduleNames.slice(0, -1).join('、')}与${moduleNames.at(-1)}`
  : (moduleNames[0] ?? '专题');
const overviewDescription = `HIT 837 专业课考研笔记，按${moduleSummary}模块组织。`;
---
<BaseLayout title="学习笔记" description={overviewDescription} bodyClass="study-overview-page">
  <header class="page-intro page-masthead">
    <div>
      <h1>学习笔记</h1>
    </div>
    <div class="masthead-stats is-two" aria-label="学习笔记统计">
      <div class="masthead-stat-card">
        <span class="masthead-stat-label">公开笔记</span>
        <CountUp to={posts.length} />
        <span class="masthead-stat-sub">含公式、图表与交互演示</span>
      </div>
      <div class="masthead-stat-card">
        <span class="masthead-stat-label">专题模块</span>
        <div class="masthead-module-counts">
          {modules.map((mod) => (
            <div class="masthead-module-item">
              <CountUp to={mod.count} />
              <span class="masthead-stat-sub">{mod.title}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </header>
  {series.map(([name, info]) => <section class="study-series-group" aria-label={info.title}><StudyModuleLinks modules={modules.filter((module) => module.series === name)} headingLevel="h2" /></section>)}
</BaseLayout>
