---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profileLabels, type KubeProfile } from '../scripts/kube/profiles';

const profiles: KubeProfile[] = ['convex-circle', 'convex-squircle', 'concave', 'lip'];
---

<BaseLayout title="液态玻璃实验室" description="实时调整 Kube 液态玻璃折射参数" bodyClass="lab-page">
  <section class="lab-intro page-intro">
    <p class="eyebrow">Optical playground</p>
    <h1>Refraction Lab</h1>
    <p>调整曲面、折射和光线参数，观察真实背景如何穿过玻璃表面。</p>
  </section>

  <section class="glass-lab glass-lab-page" aria-labelledby="glass-lab-title">
    <header class="glass-lab-heading">
      <div><p class="eyebrow">Kube SVG optics</p><h2 id="glass-lab-title">Surface parameters</h2></div>
      <div class="lab-actions"><span class="glass-support" data-glass-support>Checking renderer</span><button class="glass-reset" type="button" id="glass-reset">Reset optics</button></div>
    </header>

    <div class="glass-lab-layout">
      <div class="glass-lab-preview" aria-label="实时液态玻璃预览">
        <div class="lab-scene" aria-hidden="true"></div><div class="lab-grid" aria-hidden="true"></div>
        <div class="lab-glass-window glass-surface">
          <div class="lab-window-copy"><span class="lab-glass-index">duolaBmeng673</span><strong>Optical surface</strong><small>background / refracted / live</small></div>
          <div class="lab-progressive-blur" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
      </div>

      <form class="glass-controls" id="glass-controls">
        <fieldset class="profile-control"><legend>Surface profile</legend><div class="profile-options">
          {profiles.map((profile) => <button type="button" data-glass-profile={profile} aria-pressed="false">{profileLabels[profile]}</button>)}
        </div></fieldset>
        {[
          ['bezel', 'Bezel width', '6', '80', '1', '24'], ['refraction', 'Refraction', '0', '100', '1', '86'],
          ['thickness', 'Glass thickness', '10', '140', '1', '90'], ['light-angle', 'Light angle', '-180', '180', '5', '-150'],
          ['specular-opacity', 'Specular opacity', '0', '100', '1', '24'], ['transparency', 'Transparency', '0', '100', '1', '26'],
          ['blur', 'Blur', '0', '100', '1', '14'], ['saturation', 'Saturation', '0', '200', '1', '112'],
        ].map(([id, label, min, max, step, value]) => (
          <label class="glass-control" for={`glass-${id}`}><span>{label}</span><output id={`glass-${id}-output`} for={`glass-${id}`}>{value}</output><input id={`glass-${id}`} name={id} type="range" min={min} max={max} step={step} value={value} data-glass-control={id} /></label>
        ))}
        <label class="motion-toggle" for="glass-background-motion"><span><strong>Background motion</strong><small>Slow parallax for inspection</small></span><input id="glass-background-motion" type="checkbox" data-glass-control="background-motion" /><i aria-hidden="true"></i></label>
      </form>
    </div>
    <p class="lab-credit">Inspired by <a href="https://kube.io/blog/liquid-glass-css-svg/" target="_blank" rel="noreferrer">Kube's Liquid Glass in the Browser</a>. SVG backdrop filters are currently Chromium-only.</p>
  </section>
</BaseLayout>
