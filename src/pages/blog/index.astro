---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getCategorySummaries, getPostHref, getPostKey, getPostTitle, formatPostDate, taxonomyLabel, getTimeline, toSearchRecord } from '../../lib/blog';
const posts = await getAllPosts();
const summaries = getCategorySummaries(posts);
const timeline = getTimeline(posts);
---
<BaseLayout title="技术笔记" description="研究、代码与学习笔记" bodyClass="archive-page">
  <header class="page-intro"><p class="eyebrow">论文 · 算法 · 技术</p><h1>技术笔记</h1><p>默认浏览论文与技术文章。按考纲学习请前往 <a class="text-link" href="/study-notes/">学习笔记</a>；搜索与显式筛选覆盖全部公开笔记。</p></header>
  <section class="archive-tools" aria-label="文章筛选与浏览方式">
    <nav class="filter-row" aria-label="一级分类"><a class="filter-button is-active" href="/blog/" data-category-filter="all" aria-current="true">常规笔记 <span>{posts.filter((post) => post.collection !== 'study_notes').length}</span></a>{summaries.map((summary) => <a class="filter-button" href={`/blog/?category=${encodeURIComponent(summary.category)}`} data-category-filter={summary.category}>{taxonomyLabel(summary.category)} <span>{summary.count}</span></a>)}</nav>
    <div class="archive-actions"><div class="view-switch" role="group" aria-label="浏览方式"><button type="button" class="view-button is-active" data-view-toggle="notes" aria-pressed="true">列表</button><button type="button" class="view-button" data-view-toggle="timeline" aria-pressed="false">时间线</button></div></div>
    <div class="hierarchy-filters"><label>子分类<select data-subcategory-filter><option value="">全部子分类</option>{[...new Set(posts.map((post) => post.data.subcategory))].map((name) => <option value={name}>{taxonomyLabel(name)}</option>)}</select></label><label>系列<select data-series-filter><option value="">全部系列</option>{[...new Set(posts.map((post) => post.data.series))].map((name) => <option value={name}>{taxonomyLabel(name)}</option>)}</select></label></div>
    <p class="active-tag" data-active-tag hidden></p>
    <p class="active-query" data-active-query hidden><span data-query-label></span><button type="button" data-clear-query>清除搜索</button></p>
    <p class="result-status" data-result-status role="status">{posts.filter((post) => post.collection !== 'study_notes').length} 篇笔记</p>
  </section>
  <section class="notes-view" data-notes-view aria-label="文章列表">{posts.map((post) => <article class="note-row" data-note-row hidden={post.collection === 'study_notes'} data-id={getPostKey(post)}><a class="editorial-row" data-category={post.data.category} href={getPostHref(post)} aria-label={`阅读：${post.data.title}`}><time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time><div class="editorial-main"><span class="note-taxonomy">{taxonomyLabel(post.data.category)} · {taxonomyLabel(post.data.subcategory)} · {taxonomyLabel(post.data.series)}</span><div class="editorial-title"><h2>{getPostTitle(post)}</h2>{post.data.subtitle && <em>{post.data.subtitle}</em>}</div><span class="note-description">{post.data.description}</span></div><span class="row-arrow" aria-hidden="true">→</span></a></article>)}</section>
  <section class="timeline-view" data-timeline-view hidden aria-label="按时间浏览文章">{timeline.map((year) => <section class="timeline-year" data-timeline-year><h2>{year.year}</h2>{year.months.map((month) => <div class="timeline-month" data-timeline-month><h3>{month.label}</h3><div>{month.posts.map((post) => <a class="timeline-row" data-timeline-row hidden={post.collection === 'study_notes'} data-id={getPostKey(post)} href={getPostHref(post)}><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(5, 10).replace('-', '.')}</time><span><strong>{getPostTitle(post)}</strong>{post.data.subtitle && <em>{post.data.subtitle}</em>}<small>{taxonomyLabel(post.data.category)} · {taxonomyLabel(post.data.series)}</small></span><span aria-hidden="true">→</span></a>)}</div></div>)}</section>)}</section>
  <div class="archive-empty" data-archive-empty hidden><p>没有找到匹配的笔记。试试其他关键词或清除筛选。</p><button class="button" type="button" data-clear-filters>清除筛选</button></div>
  <script is:inline type="application/json" id="notes-index" set:html={JSON.stringify(posts.map((post) => ({ id: getPostKey(post), ...toSearchRecord(post, false) }))).replace(/</g, '\\u003c')} />
  <script>import '../../scripts/notes';</script>
</BaseLayout>
