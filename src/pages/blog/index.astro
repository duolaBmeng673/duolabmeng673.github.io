---
import CountUp from '../../components/CountUp.astro';
import { countKnowledgeCategories, getBlogKnowledgeTags, getKnowledgeTags } from '../../lib/knowledge-tags';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getCategorySummaries, getPostHref, getPostKey, getPostTitle, taxonomyLabel, getYearlyTimeline, toSearchRecord } from '../../lib/blog';
const posts = await getAllPosts();
const regularPosts = posts.filter((post) => post.collection !== 'study_notes');
const researchCount = regularPosts.filter((post) => post.data.category === 'Research').length;
const csCount = regularPosts.filter((post) => post.data.category === 'Computer Science').length;
const summaries = getCategorySummaries(regularPosts);
const legendCategories = countKnowledgeCategories(
  regularPosts.map((post) => post.id),
  getBlogKnowledgeTags,
);
const timeline = getYearlyTimeline(posts).map((yearGroup) => {
  const monthMap = new Map<string, { key: string; monthNum: number; label: string; posts: typeof yearGroup.posts; regularCount: number }>();
  for (const post of yearGroup.posts) {
    const key = post.data.pubDate.toISOString().slice(0, 7);
    const monthNum = post.data.pubDate.getUTCMonth() + 1;
    let entry = monthMap.get(key);
    if (!entry) {
      entry = { key, monthNum, label: `${yearGroup.year} 年 ${monthNum} 月`, posts: [], regularCount: 0 };
      monthMap.set(key, entry);
    }
    entry.posts.push(post);
    if (post.collection !== 'study_notes') entry.regularCount++;
  }
  const regularCount = yearGroup.posts.filter((post) => post.collection !== 'study_notes').length;
  return {
    ...yearGroup,
    regularCount,
    months: [...monthMap.values()].sort((a, b) => b.key.localeCompare(a.key)),
  };
});
---
<BaseLayout title="技术笔记" description="论文阅读与算法题解。" bodyClass="archive-page">
  <header class="page-intro page-masthead">
    <div>
      <p class="eyebrow">论文 · 算法</p>
      <h1 data-archive-title>技术笔记</h1>
    </div>
    <div class="masthead-stats" aria-label="技术归档统计">
      <div class="masthead-stat-card">
        <span class="masthead-stat-label">公开技术与论文</span>
        <CountUp to={regularPosts.length} />
      </div>
      <a class="masthead-stat-card" href="/blog/?category=Research">
        <span class="masthead-stat-label">论文精读</span>
        <CountUp to={researchCount} />
      </a>
      <a class="masthead-stat-card" href="/blog/?category=Computer%20Science">
        <span class="masthead-stat-label">算法题解</span>
        <CountUp to={csCount} />
      </a>
    </div>
  </header>
  <div class="archive-sentinel" data-archive-sentinel aria-hidden="true"></div>
  <section class="archive-tools" aria-label="文章筛选与知识点类别">
    <div class="archive-bar">
      <nav class="filter-row" aria-label="一级分类"><a class="filter-button is-active" href="/blog/" data-category-filter="all" aria-current="true">全部 <span>{regularPosts.length}</span></a>{summaries.map((summary) => <a class="filter-button" href={`/blog/?category=${encodeURIComponent(summary.category)}`} data-category-filter={summary.category}>{summary.category === 'Computer Science' ? '算法题解' : taxonomyLabel(summary.category)} <span>{summary.count}</span></a>)}</nav>
      <div class="knowledge-legend blog-legend" role="group" aria-label="知识点类别高亮">
        {legendCategories.map((cat) => <button type="button" class="blog-legend-btn" data-blog-category={cat.id} data-c={cat.id} aria-pressed="false"><span aria-hidden="true" class="knowledge-swatch"></span>{cat.label} <span class="knowledge-cat-count">{cat.count}</span></button>)}
      </div>
      <p class="result-status visually-hidden" data-result-status role="status" aria-live="polite">{regularPosts.length} 篇笔记</p>
    </div>
    <p class="active-query active-tag" data-active-tag hidden><span data-tag-label></span><button type="button" data-clear-tag>清除标签</button></p>
    <p class="active-query" data-active-query hidden><span data-query-label></span><button type="button" data-clear-query>清除搜索</button></p>
  </section>
  <section class="timeline-view" data-timeline-view aria-label="按年份浏览文章">{timeline.map((year) => {
    const yearHidden = year.regularCount === 0;
    return <section class="timeline-year" data-timeline-year={String(year.year)} hidden={yearHidden}>
      <div class="year-rail">
        <div class="timeline-year-box">
          <span class="timeline-rail-dot is-year" aria-hidden="true"></span>
          <span class="timeline-year-label">{year.year}</span>
        </div>
      </div>
      {year.months.map((month) => (
        <div class="timeline-month-band" data-timeline-month-band={month.key} hidden={month.regularCount === 0}>
          <div class="timeline-month-cell">
            <div class="timeline-month-box" data-rail-month-box={month.key}>
              <span class="timeline-rail-dot is-month" aria-hidden="true"></span>
              <span class="timeline-month-name">{month.label}</span>
            </div>
          </div>
          <div class="timeline-month-content">
            <h2 class="timeline-mobile-heading">{month.label}</h2>
            <div class="timeline-card-grid">{month.posts.map((post) => {
              const postKey = getPostKey(post);
              const postTags = post.collection === 'study_notes' ? getKnowledgeTags(post.id) : getBlogKnowledgeTags(post.id);
              const postYear = String(post.data.pubDate.getUTCFullYear());
              const postMonth = post.data.pubDate.toISOString().slice(0, 7);
              return <article class="timeline-row blog-card knowledge-entry" data-category={post.data.category} data-year={postYear} data-month={postMonth} data-timeline-row hidden={post.collection === 'study_notes'} data-id={postKey}>
                <time class="chapter-code knowledge-code blog-date-pill" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(5, 10).replace('-', '.')}</time>
                <div class="knowledge-entry-content">
                  <a class="knowledge-title" href={getPostHref(post)} aria-label={`阅读：${post.data.title}`}>{getPostTitle(post)}</a>
                  {postTags.length > 0 && <div class="knowledge-tags" role="group" aria-label={`${getPostTitle(post)}的知识点标签`}>{postTags.map((kt) => <button type="button" class="knowledge-chip blog-tag-chip" data-c={kt.category} data-blog-tag={kt.name} data-knowledge-label={kt.name} aria-pressed="false">{kt.name}</button>)}</div>}
                </div>
                <span class="knowledge-arrow" aria-hidden="true">→</span>
              </article>;
            })}</div>
          </div>
        </div>
      ))}
    </section>;
  })}</section>
  <div class="archive-empty" data-archive-empty hidden><p>没有找到匹配的笔记。试试其他关键词或清除筛选。</p><button class="button" type="button" data-clear-filters>清除筛选</button></div>
  <script is:inline type="application/json" id="notes-index" set:html={JSON.stringify(posts.map((post) => ({ id: getPostKey(post), ...toSearchRecord(post, false) }))).replace(/</g, '\\u003c')} />
  <script>import '../../scripts/notes';</script>
</BaseLayout>
