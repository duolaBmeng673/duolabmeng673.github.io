---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article" data-article-layout>
    <div class="article-controls">
      <a class="back-link" href="/blog/">← 返回文章</a>
      <button class="article-view-toggle" type="button" data-toc-toggle aria-pressed="false">
        <span aria-hidden="true">☷</span> 显示章节
      </button>
    </div>
    <div class="article-shell">
      <aside class="article-toc" data-article-toc aria-label="文章章节">
        <p class="panel-label">章节</p>
        <nav>
          <ol>
            {sections.map((heading) => <li class:list={`toc-level-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
          </ol>
        </nav>
      </aside>
      <div class="article-main">
        <header class="article-header">
          <p class="post-date">{post.data.pubDate.toLocaleDateString('zh-CN')}</p>
          <h1>{post.data.title}</h1>
          <p>{post.data.description}</p>
          <div class="tag-list">
            {post.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </header>
        <div class="article-body">
          <Content />
        </div>
      </div>
    </div>
  </article>
  <script>
    const layout = document.querySelector<HTMLElement>('[data-article-layout]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
    if (layout && toggle) {
      toggle.addEventListener('click', () => {
        const expanded = layout.classList.toggle('is-toc-visible');
        toggle.setAttribute('aria-pressed', String(expanded));
        toggle.innerHTML = expanded ? '<span aria-hidden="true">×</span> 隐藏章节' : '<span aria-hidden="true">☷</span> 显示章节';
      });
    }
  </script>
</BaseLayout>
