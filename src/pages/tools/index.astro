---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CountUp from '../../components/CountUp.astro';
import ToolCard from '../../components/ToolCard.astro';
import { groupTools, tools } from '../../data/tools';
import '../../styles/tools/index.css';
const groups = groupTools(tools);
---
<BaseLayout title="工具" description="常用工具与资源：图片、PDF、壁纸、前端组件与 AI 服务评测。">
  <header class="page-intro page-masthead">
    <div>
      <h1>工具</h1>
    </div>
    <div class="masthead-stats is-rail" aria-label="工具统计">
      <div class="masthead-rail-item is-total" data-countup-hover-zone>
        <span class="masthead-stat-label">收录工具</span>
        <span class="masthead-rail-value">
          <CountUp to={tools.length} delay={0} />
          <span class="masthead-rail-unit">项</span>
        </span>
      </div>
      <div class="masthead-rail-item" data-countup-hover-zone>
        <span class="masthead-stat-label">工具分组</span>
        <CountUp to={groups.length} delay={0.08} />
      </div>
    </div>
  </header>
  <div class="tool-groups">{groups.map((group, index) => <section class="tool-group" aria-labelledby={`tool-group-${index}`}><div class="tool-group-head"><h2 id={`tool-group-${index}`}>{group.category}</h2><span class="tool-group-count">{group.tools.length} 项</span></div><ul class="tool-grid" aria-label={`${group.category}列表`}>{group.tools.map((tool) => <li><ToolCard tool={tool} /></li>)}</ul></section>)}</div>
</BaseLayout>
