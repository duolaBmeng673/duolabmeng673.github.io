---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
import '../../styles/tools/index.css';
---
<BaseLayout title="工具" description="日常使用的小工具：哈工大空教室查询与离线快照。">
  <header class="page-intro"><p class="eyebrow">Tools</p><h1>工具</h1><p>一些实际用到的小工具。</p></header>
  <ul class="tool-grid" aria-label="可用工具">{tools.map((tool) => <li><ToolCard tool={tool} /></li>)}</ul>
</BaseLayout>
