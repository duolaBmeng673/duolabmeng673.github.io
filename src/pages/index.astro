---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientWavesIsland from '../components/islands/GradientWaves.island';
import ActivityHeatmapIsland from '../components/islands/ActivityHeatmap.island';
import { getHomePageData } from '../lib/home-data';
import '../styles/home.css';

const data = await getHomePageData();
const wavePresets = data.presets.map((p) => ({
  slug: p.slug,
  horizonColor: p.horizonColor,
  waveColor: p.waveColor,
  crestColor: p.crestColor,
  amplitude: p.amplitude,
  swell: p.swell,
  turbulence: p.turbulence,
  waveScale: p.waveScale,
  lightAngle: p.lightAngle,
  speed: p.speed,
}));

const categoryVar = (cat: string) => `var(--knowledge-${cat}, var(--tm))`;

const DANMAKU_LANE_COUNT = 6;

const activityPayloadJson = JSON.stringify({
  buildDate: data.heatmap.buildDate,
  activeDays: data.heatmap.activeDays,
  totalActivities: data.heatmap.totalActivities,
  activities: data.heatmap.rawActivities,
  writing: data.heatmap.rawWritingRecords,
});
---

<BaseLayout bodyClass="home-page">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hgrid">
      <div>
        <h1 id="hero-title">
          <span class="hero-line">Welcome to</span>
          <span class="hero-line">duolaBmeng673&apos;s blog</span>
        </h1>
        <div class="cta">
          <a class="btn" href="/blog/">笔记归档 →</a>
          <a class="btn ghost" href="/study-notes/837/">HIT 837 学习笔记</a>
        </div>
      </div>

      <p class="sub">
        <strong>杨雨飞</strong> · 哈尔滨工业大学 · 信息安全
        <br />
        多模态与表格理解论文、算法题解与 HIT 837 学习笔记。
      </p>
    </div>

    <div class="stage" data-hero-stage>
      <div class="stage-wave-wrap" aria-hidden="true">
        <GradientWavesIsland client:idle presets={wavePresets} defaultSlug="all" />
      </div>

      <div class="win w1">
        <div class="wt">
          <span class="wt-dots">
            <i />
            <i />
            <i />
            <span>about.ts</span>
          </span>
          <a href="/about/">查看个人主页 ↗</a>
        </div>
        <div class="wb">
          <div class="codeb">
            <span class="l"><span class="k">const</span> author = {'{'}</span>
            <span class="l">{'  '}name: <a class="v" href="/about/">&quot;杨雨飞&quot;</a>,</span>
            <span class="l">{'  '}handle: <a class="v" href={data.site.github} target="_blank" rel="noreferrer">&quot;{data.site.name}&quot;</a>,</span>
            <span class="l">{'  '}school: <a class="v" href="/about/">&quot;哈尔滨工业大学 · 信息安全&quot;</a>,</span>
            <span class="l">
              {'  '}focus: [<a class="v" href="/blog/?series=LLM%20%26%20Tables">&quot;表格理解&quot;</a>, <a class="v" href="/blog/?series=Multimodal">&quot;多模态&quot;</a>, <a class="v" href="/study-notes/837/">&quot;网络安全&quot;</a>],
            </span>
            <span class="l">{'  '}notes: <a class="v" href="/blog/">{data.totalCount}</a>,</span>
            <span class="l">{'  '}demo: <a class="v" href="/study-notes/837/kmp-algorithm/">&quot;KMP / 837 背诵模式&quot;</a>,</span>
            <span class="l">{'}'}</span>
            <span class="l"><span class="k">export default</span> author</span>
          </div>
        </div>
      </div>

      <div class="win w3">
        <div class="wt">
          <span>Presets · 实时切换波浪色相与索引</span>
        </div>
        <div class="wb pst" id="pst" role="radiogroup" aria-label="笔记分类">
          {data.presets.map((cat, idx) => (
            <button
              type="button"
              class="r"
              role="radio"
              aria-checked={idx === 0 ? 'true' : 'false'}
              data-preset-slug={cat.slug}
              data-more-href={cat.moreHref}
              data-more-label={cat.moreLabel}
            >
              <span class="sw" aria-hidden="true">
                <i style={`background: ${cat.horizonColor};`} />
                <i style={`background: ${cat.waveColor};`} />
                <i style={`background: ${cat.crestColor};`} />
              </span>
              <span>{cat.name}</span>
              <span class="n">{cat.presetName} · {cat.count} 篇</span>
            </button>
          ))}
        </div>
        <div class="more-row">
          <span>点击终端内标题可直接阅读</span>
          <a id="stage-more" data-stage-more href={data.presets[0].moreHref}>{data.presets[0].moreLabel}</a>
        </div>
      </div>

      <div class="win w2">
        <div class="wt">
          <span>Terminal · 点击右侧切换频道</span>
          <button class="cp" id="cp" type="button" data-copy-rss aria-label="复制 RSS 订阅地址">⧉ 复制 RSS</button>
        </div>
        <div class="wb term" id="term" aria-live="polite">
          <div class="tl">
            <span class="pr">$ </span>
            <span data-terminal-cmd>notes ls --cat=all --limit=6</span>
          </div>
          {data.presets.map((cat, idx) => (
            <div class="term-panel" data-preset-panel={cat.slug} hidden={idx !== 0}>
              {cat.notes.map((n, k) => (
                <div class="tl fi" style={`animation-delay: ${k * 75}ms;`}>
                  <span class="ok">✓</span>
                  <span class="dim">{n.date}</span>
                  <a href={n.href}>{n.title}</a>
                </div>
              ))}
            </div>
          ))}
          <div class="tl">
            <span class="pr">$ </span>
            <i class="cur" aria-hidden="true" />
          </div>
        </div>
      </div>

      <div class="win w4" data-activity-payload={activityPayloadJson}>
        <ActivityHeatmapIsland
          client:visible
          buildDate={data.heatmap.buildDate}
          writingItems={data.heatmap.writingItems}
          activityItems={data.heatmap.activityItems}
          recentFallbackItems={data.heatmap.recentActivityPreview}
          initialActiveDays={data.heatmap.activeDays}
          initialTotalActivities={data.heatmap.totalActivities}
          initialLongestStreak={data.heatmap.longestStreak}
          initialMonthActivities={data.heatmap.monthActivities}
        />
      </div>
    </div>
  </section>

  <section class="sec" id="tracks" aria-labelledby="tracks-heading">
    <div class="sec-head">
      <div>
        <span class="sec-kicker">THREE TRACKS</span>
        <h2 id="tracks-heading">三条主线</h2>
      </div>
      <a class="card-link" href="/blog/?view=timeline">时间线浏览 →</a>
    </div>

    <div class="bento">
      <article class="card track-card rb-panel s4">
        <div class="track-head">
          <div class="track-badge">
            <span class="cat-dot" data-cat="Research" aria-hidden="true" />
            <span>Research</span>
          </div>
          <span class="track-count">{data.tracks.research.count} 篇</span>
        </div>
        <h3>论文笔记</h3>
        <p class="track-desc">
          <a href="/blog/?series=NLP">自然语言处理</a>、<a href="/blog/?series=Multimodal">多模态与视觉</a>与<a href="/blog/?series=LLM%20%26%20Tables">大模型与表格</a>论文精读。
        </p>
        <ul class="track-list">
          {data.tracks.research.items.map((item) => (
            <li>
              <a href={item.href}>
                <span class="track-item-title">{item.title}</span>
                <time>{item.dateShort}</time>
              </a>
            </li>
          ))}
        </ul>
        <div class="track-foot">
          <a class="card-link" href="/blog/?category=Research">全部论文 →</a>
        </div>
      </article>

      <article class="card track-card rb-panel s4">
        <div class="track-head">
          <div class="track-badge">
            <span class="cat-dot" data-cat="Computer Science" aria-hidden="true" />
            <span>Computer Science</span>
          </div>
          <span class="track-count">{data.tracks.cs.count} 篇</span>
        </div>
        <h3>技术笔记</h3>
        <p class="track-desc">ACM / OJ 算法竞赛题解、输入输出模板与工程实践。</p>
        <ul class="track-list">
          {data.tracks.cs.items.map((item) => (
            <li>
              <a href={item.href}>
                <span class="track-item-title">{item.title}</span>
                <time>{item.dateShort}</time>
              </a>
            </li>
          ))}
        </ul>
        <div class="track-foot">
          <a class="card-link" href="/blog/?category=Computer+Science">全部技术 →</a>
        </div>
      </article>

      <article class="card track-card rb-panel s4">
        <div class="track-head">
          <div class="track-badge">
            <span class="cat-dot" data-cat="Study Notes" aria-hidden="true" />
            <span>HIT 837</span>
          </div>
          <span class="track-count">{data.tracks.study.count} 篇</span>
        </div>
        <h3>837 学习笔记</h3>
        <p class="track-desc">
          围绕<a href="/study-notes/837/">算法与信息安全</a>考纲整理（信息安全导论与网络安全基础，含背诵模式）。
        </p>
        <ul class="track-list">
          <li>
            <a href="/study-notes/837/information-security/">
              <span class="track-item-title">《信息安全导论》考纲目录</span>
              <time>{data.tracks.study.infoSecCount} 篇</time>
            </a>
          </li>
          <li>
            <a href="/study-notes/837/network-security/">
              <span class="track-item-title">《网络安全基础》考纲目录</span>
              <time>{data.tracks.study.netSecCount} 篇</time>
            </a>
          </li>
          <li>
            <a href="/study-notes/837/kmp-algorithm/">
              <span class="track-item-title">KMP 算法交互式分步演算</span>
              <time>交互</time>
            </a>
          </li>
        </ul>
        <div class="track-foot">
          <a class="card-link" href="/study-notes/837/">进入考纲系统 →</a>
        </div>
      </article>
    </div>
  </section>

  <section class="sec" id="explore-sec" aria-labelledby="explore-heading">
    <div class="sec-head">
      <div>
        <span class="sec-kicker">QUICK INDEX</span>
        <h2 id="explore-heading">知识点快查与专题直达</h2>
      </div>
      <span class="sec-sub">悬停弹幕暂停或滑动浏览，右侧卡片可切换专题直达</span>
    </div>

    <div class="bento">
      <div class="card rb-panel s7">
        <div class="vis ktag-vis ktag-danmaku" data-danmaku aria-label="837 知识点标签快查弹幕">
          <div class="ktag-stage" data-danmaku-stage>
            {Array.from({ length: DANMAKU_LANE_COUNT }, (_, laneIdx) => (
              <div class="ktag-lane" data-lane={laneIdx} />
            ))}
          </div>
          <div class="ktag-pool" data-danmaku-pool>
            {data.allKnowledgeTags.map((item) => (
              <a
                class="tag ktag-pill-lg"
                href={item.href}
                title={item.tooltip}
                data-knowledge-label={item.name}
                data-category={item.category}
              >
                <span class="ktag-swatch" style={`background: ${categoryVar(item.category)};`} aria-hidden="true" />
                <span>{item.name}</span>
              </a>
            ))}
          </div>
        </div>
        <div class="card-foot">
          <div>
            <h3>837 知识点快查（{data.allKnowledgeTags.length}）</h3>
            <p>悬停暂停、支持横向滑动；点击直达对应笔记或相关集合。</p>
          </div>
          <a class="card-link" href="/study-notes/837/information-security/">完整考纲 →</a>
        </div>
      </div>

      <div class="card rb-panel s5">
        <div class="vis swap-lab-vis" data-card-swap>
          <div class="card-swap-stage">
            {data.swapCards.map((card, idx) => (
              <a
                class="card-swap-slot"
                href={card.href}
                data-swap-slot={idx}
                data-front={idx === 0 ? '' : undefined}
              >
                <div class="swap-blog-card">
                  <div class="swap-blog-top">
                    <span class="swap-blog-badge" style={`color: ${card.accent};`}>
                      {card.icon === 'book' && (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                        </svg>
                      )}
                      {card.icon === 'sparkles' && (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" />
                        </svg>
                      )}
                      {card.icon === 'cpu' && (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <rect width="16" height="16" x="4" y="4" rx="2" />
                          <rect width="6" height="6" x="9" y="9" rx="1" />
                          <path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" />
                        </svg>
                      )}
                      {card.icon === 'sigma' && (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M18 7V4H6l6 8-6 8h12v-3" />
                        </svg>
                      )}
                      {card.icon === 'code' && (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <polyline points="16 18 22 12 16 6" />
                          <polyline points="8 6 2 12 8 18" />
                        </svg>
                      )}
                      <span>{card.cat}</span>
                    </span>
                    <svg class="swap-blog-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M7 7h10v10" />
                      <path d="M7 17 17 7" />
                    </svg>
                  </div>
                  <div class="swap-blog-body">
                    <strong>{card.title}</strong>
                    <p>{card.desc}</p>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <div class="swap-controls" aria-label="专题卡片切换控制">
            <button type="button" class="swap-ctrl-btn" data-swap-prev aria-label="上一张专题卡片">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
              </svg>
            </button>
            <span class="swap-ctrl-count" data-swap-count>1 / {data.swapCards.length}</span>
            <button type="button" class="swap-ctrl-btn" data-swap-next aria-label="下一张专题卡片">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </button>
          </div>
        </div>
        <div class="card-foot">
          <div>
            <h3>专题传送门</h3>
            <p>精选专题卡片；点击直达或左右切换。</p>
          </div>
          <a class="card-link" href="/blog/">笔记归档 ↗</a>
        </div>
      </div>
    </div>
  </section>

  <a class="home-tool-entry" href="/tools/">
    <span class="home-tool-main">
      <span class="home-tool-mark" aria-hidden="true">⌘</span>
      <span><strong>常用工具</strong><small>在线工具与常用效率资源外链合集</small></span>
    </span>
    <span class="home-tool-arrow" aria-hidden="true">→</span>
  </a>

  <script>
    import '../scripts/home';
  </script>
</BaseLayout>
