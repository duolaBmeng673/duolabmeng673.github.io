---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import { getAllPosts, getCategorySummaries, taxonomyLabel } from '../lib/blog';
import { siteConfig } from '../config';
const posts = await getAllPosts();
const summaries = getCategorySummaries(posts);
const recentGroups = summaries.map(({ category }) => ({ category, posts: posts.filter((post) => post.data.category === category).slice(0, category === 'Research' ? 3 : 2) }));
const selected = ['llm-table-processing-survey', 'clip', 'acm_io'].map((id) => posts.find((post) => post.id === id)).filter((post) => post !== undefined);
const interests = [
  { category: 'Research', title: '自然语言处理', href: '/blog/?series=NLP' },
  { category: 'Research', title: '多模态与视觉', href: '/blog/?series=Multimodal' },
  { category: 'Research', title: '大模型与表格', href: '/blog/?series=LLM%20%26%20Tables' },
  { category: 'Study Notes', title: '算法与信息安全', href: '/study-notes/837/' },
];
---
<BaseLayout bodyClass="home-page">
  <section class="identity-section" aria-labelledby="identity-title">
    <div class="identity-copy">
      <h1 id="identity-title">杨雨飞</h1>
      <p class="identity-name">哈尔滨工业大学 · 信息安全</p>
      <div class="identity-actions"><a class="button primary" href="/blog/">浏览全部笔记 →</a><a class="text-link" href={siteConfig.github}>公开代码 / GitHub ↗</a></div>
    </div>
    <aside class="notebook-index" aria-label="笔记入口"><p class="panel-label">笔记索引</p>{summaries.map((summary) => <a data-category={summary.category} href={summary.category === 'Study Notes' ? '/study-notes/' : `/blog/?category=${encodeURIComponent(summary.category)}`}><span><span class="category-dot" aria-hidden="true"></span>{taxonomyLabel(summary.category)}</span><span class="index-count">{summary.count} 篇</span></a>)}</aside>
  </section>
  <section class="home-section" aria-labelledby="interests-title"><div class="section-heading"><h2 id="interests-title">关注方向</h2></div><ul class="interest-list">{interests.map((interest) => <li><a href={interest.href} data-category={interest.category}><span class="category-dot" aria-hidden="true"></span><strong>{interest.title}</strong></a></li>)}</ul></section>
  <section class="home-section selected-reading" aria-labelledby="selected-title"><div class="section-heading"><h2 id="selected-title">精选阅读</h2><a class="text-link" href="/blog/">查看全部笔记 →</a></div><NoteList posts={selected} /></section>
  <section class="home-section" aria-labelledby="recent-title"><div class="section-heading"><h2 id="recent-title">近期笔记</h2><span class="section-description">各类按首次发布日期降序</span></div>{recentGroups.map((group) => <section class="recent-group"><header><h3>最新{taxonomyLabel(group.category)}</h3><a class="text-link" href={group.category === 'Study Notes' ? '/study-notes/' : `/blog/?category=${encodeURIComponent(group.category)}`}>查看全部 →</a></header><NoteList posts={group.posts} grouped /></section>)}</section>
  <div class="home-about-links"><a class="text-link" href="/about/">关于我 →</a><a class="text-link" href={siteConfig.github}>GitHub ↗</a><a class="text-link" href="/rss.xml">RSS 订阅 →</a></div>
</BaseLayout>
