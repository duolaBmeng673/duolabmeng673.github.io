---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="home-hero hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">duolaBmeng673's blog</p>
      <h1>Notes on systems,<br />software, and security.</h1>
      <p class="hero-intro">
        A personal index for web development, distributed systems, and the work of building clear, reliable software.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/blog/">Read notes</a>
        <a class="button secondary" href="/about/">About me</a>
      </div>
    </div>
    <span class="spectrum-corner" aria-hidden="true"></span>
    <span class="spectrum-wave" aria-hidden="true"></span>
  </section>

  <section class="feature-band" aria-label="关注方向">
    <article data-reveal data-tilt>
      <span>01</span>
      <h2>Web Development</h2>
      <p>关注前端体验、静态站点、工程化和可维护的产品界面。</p>
    </article>
    <article data-reveal data-tilt>
      <span>02</span>
      <h2>Distributed Systems</h2>
      <p>记录系统设计、网络通信、可靠性和工程实践里的关键取舍。</p>
    </article>
    <article data-reveal data-tilt>
      <span>03</span>
      <h2>AI & Algorithms</h2>
      <p>整理模型应用、算法训练和安全视角下的问题分析。</p>
    </article>
  </section>

  <section class="section latest-section" data-reveal>
    <div class="section-heading">
      <p class="eyebrow">Latest Posts</p>
      <h2>最新文章</h2>
    </div>
    <div class="post-grid">
      {posts.map((post) => (
        <article class="post-card" data-reveal data-tilt>
          <p class="post-date">{post.data.pubDate.toLocaleDateString('zh-CN')}</p>
          <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <div class="mini-tags">
            {post.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
