---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientWavesIsland from '../components/islands/GradientWaves.island';
import ActivityHeatmapIsland from '../components/islands/ActivityHeatmap.island';
import TechTextIsland from '../components/islands/TechText.island';
import { tools } from '../data/tools';
import { getHomePageData } from '../lib/home-data';
import { loadLucideSvg } from '../lib/tool-icons';
import '../styles/home.css';

const data = await getHomePageData();
const techNoteCount = data.tracks.research.count + data.tracks.cs.count;
const mobileStageCards = [
  {
    title: '技术笔记',
    href: '/blog/',
    meta: `${techNoteCount} 篇 · 论文与算法`,
    iconSvg: loadLucideSvg('code-xml'),
  },
  {
    title: '学习笔记',
    href: '/study-notes/',
    meta: `${data.tracks.study.count} 篇 · HIT 837`,
    iconSvg: loadLucideSvg('book-open'),
  },
  {
    title: '工具',
    href: '/tools/',
    meta: `${tools.length} 项 · 精选效率`,
    iconSvg: loadLucideSvg('wrench'),
  },
  {
    title: '关于',
    href: '/about/',
    meta: '杨雨飞 · 个人主页',
    iconSvg: loadLucideSvg('user-round'),
  },
];
const wavePresets = data.presets.map((p) => ({
  slug: p.slug,
  horizonColor: p.horizonColor,
  waveColor: p.waveColor,
  crestColor: p.crestColor,
  amplitude: p.amplitude,
  swell: p.swell,
  turbulence: p.turbulence,
  waveScale: p.waveScale,
  lightAngle: p.lightAngle,
  speed: p.speed,
}));

const initialReview = data.dailyReview.items[data.dailyReview.initialIndex] ?? {
  question: '进入 837 考纲笔记开始背诵与复习',
  isExam: false,
  subject: '837 考纲',
  noteTitle: '学习笔记目录',
  href: '/study-notes/837/',
};

const activityPayloadJson = JSON.stringify({
  buildDate: data.heatmap.buildDate,
  activeDays: data.heatmap.activeDays,
  totalActivities: data.heatmap.totalActivities,
  activities: data.heatmap.rawActivities,
  writing: data.heatmap.rawWritingRecords,
});
---

<BaseLayout bodyClass="home-page">
  <div class="home-root" data-home-root>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hgrid">
      <div>
        <h1 id="hero-title" lang="en">
          <span class="hero-line">Welcome to <span class="hero-tech-wrap"><span class="hero-tech-fallback">duolaBmeng673</span><span class="hero-tech-canvas-slot" aria-hidden="true"><TechTextIsland client:media="(min-width: 900px)" text="duolaBmeng673" /></span></span>’s</span>
          <span class="hero-line">notes and blog</span>
        </h1>
        <div class="cta">
          <a class="btn" href="/blog/">笔记归档 →</a>
        </div>
      </div>
    </div>

    <div class="stage" data-hero-stage>
      <div class="stage-wave-wrap" aria-hidden="true">
        <GradientWavesIsland client:media="(min-width: 900px)" presets={wavePresets} defaultSlug="all" />
      </div>

      <nav class="mobile-stage-grid" aria-label="站点主要板块">
        {mobileStageCards.map((card) => (
          <a class="mobile-stage-card" href={card.href}>
            <span class="mobile-stage-icon" aria-hidden="true"><Fragment set:html={card.iconSvg} /></span>
            <strong class="mobile-stage-title">{card.title}</strong>
            <span class="mobile-stage-meta">{card.meta}</span>
          </a>
        ))}
      </nav>

      <div class="win w1">
        <div class="wt">
          <span class="wt-dots">
            <i />
            <i />
            <i />
            <span>about.ts</span>
          </span>
          <a href="/about/">查看个人主页 ↗</a>
        </div>
        <div class="wb">
          <div class="codeb">
            <span class="l"><span class="k">const</span> <span class="sym">author</span> = {'{'}</span>
            <span class="l">{'  '}<span class="prop">name</span>: <a class="v v-str" href="/about/">&quot;杨雨飞&quot;</a>,</span>
            <span class="l">{'  '}<span class="prop">handle</span>: <a class="v v-str" href={data.site.github} target="_blank" rel="noreferrer">&quot;{data.site.name}&quot;</a>,</span>
            <span class="l">{'  '}<span class="prop">school</span>: <a class="v v-str" href="/about/">&quot;哈尔滨工业大学 · 信息安全&quot;</a>,</span>
            <span class="l">
              {'  '}<span class="prop">focus</span>: [<a class="v v-str" href="/blog/?series=LLM%20%26%20Tables">&quot;表格理解&quot;</a>, <a class="v v-str" href="/blog/?series=Multimodal">&quot;多模态&quot;</a>, <a class="v v-str" href="/study-notes/837/">&quot;网络安全&quot;</a>],
            </span>
            <span class="l">{'  '}<span class="prop">notes</span>: <a class="v v-num" href="/blog/">{data.totalCount}</a>,</span>
            <span class="l">{'  '}<span class="prop">demo</span>: <a class="v v-str" href="/study-notes/837/kmp-algorithm/">&quot;KMP / 837 背诵模式&quot;</a>,</span>
            <span class="l">{'}'}</span>
            <span class="l"><span class="k">export default</span> <span class="fn">author</span></span>
          </div>
        </div>
      </div>

      <div class="win w3">
        <div class="wt">
          <span>Presets</span>
        </div>
        <div class="wb pst" id="pst" role="radiogroup" aria-label="笔记分类">
          {data.presets.map((cat, idx) => (
            <button
              type="button"
              class="r"
              role="radio"
              aria-checked={idx === 0 ? 'true' : 'false'}
              data-preset-slug={cat.slug}
            >
              <span class="sw" aria-hidden="true">
                <i style={`background: ${cat.horizonColor};`} />
                <i style={`background: ${cat.waveColor};`} />
                <i style={`background: ${cat.crestColor};`} />
              </span>
              <span>{cat.name}</span>
              <span class="n">{cat.presetName} · {cat.count} 篇</span>
            </button>
          ))}
        </div>
      </div>

      <div class="win w2">
        <div class="wt">
          <span>Terminal</span>
          <button class="cp" id="cp" type="button" data-copy-rss aria-label="复制 RSS 订阅地址">⧉ 复制 RSS</button>
        </div>
        <div class="wb term" id="term" aria-live="polite">
          <div class="tl">
            <span class="pr">$ </span>
            <span data-terminal-cmd>notes ls --cat=all --limit=6</span>
          </div>
          {data.presets.map((cat, idx) => (
            <div class="term-panel" data-preset-panel={cat.slug} hidden={idx !== 0}>
              {cat.notes.map((n, k) => (
                <div class="tl fi" style={`animation-delay: ${k * 75}ms;`}>
                  <span class="ok">✓</span>
                  <span class="dim">{n.date}</span>
                  <a href={n.href}>{n.title}</a>
                </div>
              ))}
            </div>
          ))}
          <div class="tl">
            <span class="pr">$ </span>
            <i class="cur" aria-hidden="true" />
          </div>
        </div>
      </div>

      <div class="win w4" data-activity-payload={activityPayloadJson}>
        <ActivityHeatmapIsland
          client:media="(min-width: 900px)"
          buildDate={data.heatmap.buildDate}
          writingItems={data.heatmap.writingItems}
          activityItems={data.heatmap.activityItems}
          recentFallbackItems={data.heatmap.recentActivityPreview}
          initialActiveDays={data.heatmap.activeDays}
          initialTotalActivities={data.heatmap.totalActivities}
          initialLongestStreak={data.heatmap.longestStreak}
          initialMonthActivities={data.heatmap.monthActivities}
          initialWindowLabel={data.heatmap.windowLabel}
        />
      </div>
    </div>
  </section>

  <section class="sec" id="tracks" aria-labelledby="tracks-heading">
    <div class="sec-head">
      <div>
        <span class="sec-kicker">THREE TRACKS</span>
        <h2 id="tracks-heading">三条主线</h2>
      </div>
      <a class="card-link" href="/blog/?view=timeline">时间线浏览 →</a>
    </div>

    <div class="bento">
      <article class="card track-card rb-panel s4">
        <div class="track-head">
          <h3>论文笔记</h3>
          <span class="track-count">{data.tracks.research.count} 篇</span>
        </div>
        <p class="track-desc">
          <a href="/blog/?series=NLP">自然语言处理</a>、<a href="/blog/?series=Multimodal">多模态与视觉</a>与<a href="/blog/?series=LLM%20%26%20Tables">大模型与表格</a>论文精读。
        </p>
        <ul class="track-list">
          {data.tracks.research.items.map((item) => (
            <li>
              <a href={item.href}>
                <span class="track-item-title">{item.title}</span>
                <time>{item.dateShort}</time>
              </a>
            </li>
          ))}
        </ul>
        <div class="track-foot">
          <a class="card-link" href="/blog/?category=Research">全部论文 →</a>
        </div>
      </article>

      <article class="card track-card rb-panel s4">
        <div class="track-head">
          <h3>技术笔记</h3>
          <span class="track-count">{data.tracks.cs.count} 篇</span>
        </div>
        <p class="track-desc">ACM / OJ 算法竞赛题解、输入输出模板与工程实践。</p>
        <ul class="track-list">
          {data.tracks.cs.items.map((item) => (
            <li>
              <a href={item.href}>
                <span class="track-item-title">{item.title}</span>
                <time>{item.dateShort}</time>
              </a>
            </li>
          ))}
        </ul>
        <div class="track-foot">
          <a class="card-link" href="/blog/?category=Computer+Science">全部技术 →</a>
        </div>
      </article>

      <article class="card track-card rb-panel s4 is-study-track">
        <div class="track-head">
          <h3>837 学习笔记</h3>
          <span class="track-count">{data.tracks.study.count} 篇</span>
        </div>
        <p class="track-desc">
          围绕<a href="/study-notes/837/">算法与信息安全</a>考纲整理（信息安全导论、网络安全基础与计算机网络，含背诵模式）。
        </p>
        <ul class="track-list">
          <li>
            <a href="/study-notes/837/information-security/">
              <span class="track-item-title">《信息安全导论》考纲目录</span>
              <time>{data.tracks.study.infoSecCount} 篇</time>
            </a>
          </li>
          <li>
            <a href="/study-notes/837/network-security/">
              <span class="track-item-title">《网络安全基础》考纲目录</span>
              <time>{data.tracks.study.netSecCount} 篇</time>
            </a>
          </li>
          <li>
            <a href="/study-notes/837/computer-networks/">
              <span class="track-item-title">《计算机网络》考纲目录</span>
              <time>{data.tracks.study.cnCount} 篇</time>
            </a>
          </li>
          <li>
            <a href="/study-notes/837/kmp-algorithm/">
              <span class="track-item-title">KMP 算法交互式分步演算</span>
              <time>交互</time>
            </a>
          </li>
        </ul>
        <div class="track-foot">
          <a class="card-link" href="/study-notes/837/">进入考纲系统 →</a>
        </div>
      </article>
    </div>
  </section>

  <section class="sec" id="daily-review-sec" aria-labelledby="daily-review-heading">
    <div class="sec-head">
      <div>
        <span class="sec-kicker">DAILY REVIEW</span>
        <h2 id="daily-review-heading">今日随机复习</h2>
      </div>
      <a class="card-link" href="/study-notes/837/">全部 837 考纲 →</a>
    </div>

    <article class="card rb-panel daily-review-card" data-daily-review>
      <div class="daily-review-meta">
        <span class="daily-review-badge" data-review-badge hidden={!initialReview.isExam}>原题</span>
        <span class="daily-review-source" data-review-source>{initialReview.subject} · {initialReview.noteTitle}</span>
        <span class="daily-review-date" data-review-date>{data.dailyReview.buildDate}</span>
      </div>
      <p class="daily-review-question" data-review-question>{initialReview.question}</p>
      <div class="daily-review-actions">
        <button type="button" class="daily-review-shuffle" data-review-shuffle>换一题</button>
        <a class="btn daily-review-go" data-review-link href={initialReview.href}>去复习 →</a>
      </div>
      <script is:inline type="application/json" id="daily-review-pool" set:html={JSON.stringify(data.dailyReview).replace(/</g, '\\u003c')} />
    </article>
  </section>
  </div>

  <script>
    import '../scripts/home';
  </script>
</BaseLayout>
