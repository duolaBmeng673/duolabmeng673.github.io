---
import '../styles/global.css';
import { siteConfig } from '../config';
interface Props { title?: string; description?: string; bodyClass?: string }
const { title = siteConfig.title, description = siteConfig.description, bodyClass = '' } = Astro.props;
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA ?? 'local';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN" data-build={buildSha}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let mode = 'system';
        try {
          const saved = localStorage.getItem('duolabmeng673:theme:v2') ?? localStorage.getItem('duolabmeng673:theme:v1');
          if (['light', 'dark', 'system'].includes(saved)) mode = saved;
        } catch {}
        root.dataset.themeMode = mode;
        root.dataset.theme = mode === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : mode;
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">duolaBmeng673<span aria-hidden="true">·</span></a>
        <nav class="nav" aria-label="主导航">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          <a href="/blog/" aria-current={path.startsWith('/blog/') ? 'page' : undefined}>Notes</a>
          <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
        </nav>
        <div class="header-search" data-search-shell>
          <form class="header-search-form" data-search-form action="/blog/" method="get">
            <label for="header-search-input" class="visually-hidden">搜索文章</label>
            <input id="header-search-input" data-search-input type="search" name="q" placeholder="Search notes…" autocomplete="off" aria-controls="header-search-results" aria-expanded="false" />
            <kbd aria-hidden="true">⌘K</kbd>
          </form>
          <div id="header-search-results" class="search-popover" data-search-popover hidden>
            <p class="search-status" data-search-status role="status">输入关键词，搜索标题、分类、系列和标签。</p>
            <ul class="search-results" data-search-results></ul>
            <a class="search-all" data-search-all href="/blog/">查看全部结果 →</a>
          </div>
        </div>
        <div class="header-tools">
          <label class="theme-control"><span class="visually-hidden">主题模式</span>
            <select data-theme-select aria-label="主题模式"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select>
          </label>
          <details class="type-settings">
            <summary aria-label="文字设置">Aa</summary>
            <div class="type-settings-panel">
              <span class="panel-label">文字大小</span>
              <div class="type-size-options" role="group" aria-label="文字大小">
                <button type="button" data-font-size="small" aria-pressed="false">小</button>
                <button type="button" data-font-size="medium" aria-pressed="false">中</button>
                <button type="button" data-font-size="large" aria-pressed="false">大</button>
              </div>
              <label class="type-bold-toggle"><span>加粗文字</span><input type="checkbox" data-font-bold /></label>
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {siteConfig.name}</span>
      <span>Research, code & notes <span aria-hidden="true">·</span> <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub ↗</a></span>
    </footer>
    <script>
      import '../scripts/typography';
      import '../scripts/site-search';
    </script>
  </body>
</html>
