---
import '../styles/global.css';
import { siteConfig } from '../config';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  bodyClass = '',
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA ?? 'local';
---

<!doctype html>
<html lang="zh-CN" data-build={buildSha}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <a class="brand" href="/about/" aria-label="查看杨雨飞的个人主页">
        <img src="/github-avatar.png" alt="杨雨飞的 GitHub 头像" />
      </a>
      <nav class="nav" aria-label="主导航">
        <a href="/">首页</a>
        <a href="/blog/">博客</a>
        <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="切换到浅色主题" title="切换主题">
        <span class="theme-mark" aria-hidden="true"></span>
        <span class="visually-hidden">切换主题</span>
      </button>
      <details class="type-settings">
        <summary aria-label="文字设置">Aa</summary>
        <div class="type-settings-panel">
          <span class="type-settings-label">文字大小</span>
          <div class="type-size-options" role="group" aria-label="文字大小">
            <button type="button" data-font-size="small" aria-pressed="false">小</button>
            <button type="button" data-font-size="medium" aria-pressed="false">中</button>
            <button type="button" data-font-size="large" aria-pressed="false">大</button>
          </div>
          <label class="type-bold-toggle"><span>加粗文字</span><input type="checkbox" data-font-bold /><i aria-hidden="true"></i></label>
        </div>
      </details>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {siteConfig.name}</span>
      <span>Thoughts, notes, and systems.</span>
    </footer>
    <script>
      import '../scripts/typography';
    </script>
  </body>
</html>
