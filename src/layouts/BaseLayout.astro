---
import 'katex/dist/katex.min.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/knowledge-tags.css';
import { siteConfig } from '../config';
import { STORAGE_KEYS } from '../lib/storage-keys';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  bodyClass = '',
  type = 'website',
  published,
  updated,
  noindex = false,
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA ?? 'local';
const path = Astro.url.pathname;
const channel = path === '/'
  ? 'home'
  : path.startsWith('/study-notes/')
    ? 'study'
    : path.startsWith('/blog/')
      ? 'blog'
      : path.startsWith('/tools/')
        ? 'tools'
        : 'site';
const isNotFound = path === '/404' || path === '/404/' || path === '/404.html';
const image = new URL('/og-default.png', Astro.site);

const navItems = [
  { label: '首页', href: '/', active: path === '/' },
  { label: '技术笔记', href: '/blog/', active: path.startsWith('/blog/') },
  { label: '学习笔记', href: '/study-notes/', active: path.startsWith('/study-notes/') },
  { label: '工具', href: '/tools/', active: path.startsWith('/tools/') },
  { label: '关于', href: '/about/', active: path === '/about/' },
];
---
<!doctype html>
<html lang="zh-CN" data-build={buildSha}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!isNotFound && <meta property="og:url" content={new URL(path, Astro.site)} />}
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="duolaBmeng673 · 信息安全、AI 与技术笔记" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="icon" href="/favicon.svg" />
    {!isNotFound && <link rel="canonical" href={new URL(path, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title="duolaBmeng673 的笔记" href="/rss.xml" />
    <title>{pageTitle}</title>
    <script
      is:inline
      define:vars={{
        themeKey: STORAGE_KEYS.theme,
        themeLegacyKey: STORAGE_KEYS.themeLegacy,
        typographyKey: STORAGE_KEYS.typography,
        svgScrimKey: STORAGE_KEYS.svgScrim,
        presetKey: STORAGE_KEYS.preset,
      }}
    >
      (() => {
        const root = document.documentElement;
        let mode = 'system';
        try {
          const saved = localStorage.getItem(themeKey) ?? localStorage.getItem(themeLegacyKey);
          if (['light', 'dark', 'system'].includes(saved)) mode = saved;
          const typo = JSON.parse(localStorage.getItem(typographyKey) || '{}');
          const scales = { small: '0.94', medium: '1', large: '1.12' };
          if (typo.size && scales[typo.size]) root.style.setProperty('--font-scale', scales[typo.size]);
          if (typo.bold === true) root.setAttribute('data-font-bold', '');
          root.style.setProperty('--svg-scrim-opacity', localStorage.getItem(svgScrimKey) === 'true' ? '0.8' : '0');
          const savedPreset = localStorage.getItem(presetKey);
          if (savedPreset && /^[a-z0-9-]+$/i.test(savedPreset)) root.dataset.preset = savedPreset;
        } catch {}
        root.dataset.themeMode = mode;
        root.dataset.theme = mode === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : mode;
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.setAttribute('content', root.dataset.theme === 'dark' ? '#08070c' : '#f7f6f2');
      })();
    </script>
  </head>
  <body class={bodyClass} data-channel={channel}>
    <div class="dotgrid-hero-backdrop" aria-hidden="true">
      <canvas data-ambient-grid></canvas>
    </div>

    <a class="skip-link" href="#main-content">跳到正文</a>

    <header class="site-header" data-page={path === '/' ? 'home' : 'subpage'}>
      <div class="header-inner">
        <a class="brand" href="/"><span class="brand-full">duolaBmeng673</span><span class="brand-short" aria-hidden="true">d673</span><span class="gd" aria-hidden="true"></span></a>

        <nav class="nav" aria-label="主导航">
          {navItems.map((item) => (
            <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>

        <div class="header-tools">
          <div class="header-search" data-search-shell>
            <form class="header-search-form" data-search-form action="/blog/" method="get">
              <svg class="header-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.3-4.3" />
              </svg>
              <label for="header-search-input" class="visually-hidden">搜索文章</label>
              <input
                id="header-search-input"
                data-search-input
                type="search"
                name="q"
                placeholder="搜索全部笔记…"
                autocomplete="off"
                aria-controls="header-search-results"
                aria-expanded="false"
              />
              <kbd aria-hidden="true" data-search-shortcut>Ctrl K</kbd>
            </form>
            <div id="header-search-results" class="search-popover" data-search-popover hidden>
              <p class="search-status" data-search-status role="status">输入关键词，搜索标题、标签与正文。</p>
              <ul class="search-results" data-search-results></ul>
              <a class="search-all" data-search-all href="/blog/">查看全部结果 →</a>
            </div>
          </div>

          <details class="type-settings">
            <summary aria-label="设置" aria-expanded="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
              </svg>
            </summary>
            <div class="type-settings-panel" role="group" aria-labelledby="settings-panel-title">
              <p id="settings-panel-title" class="settings-panel-title">设置</p>
              <div class="settings-group">
                <span class="panel-label">文字大小</span>
                <div class="type-size-options" role="group" aria-label="文字大小">
                  <button type="button" data-font-size="small" aria-pressed="false">小</button>
                  <button type="button" data-font-size="medium" aria-pressed="false">中</button>
                  <button type="button" data-font-size="large" aria-pressed="false">大</button>
                </div>
              </div>
              <div class="type-switch-row">
                <div class="type-switch-copy">
                  <span id="setting-bold-label" class="type-switch-label">加粗文字</span>
                </div>
                <button
                  type="button"
                  class="pill-switch"
                  role="switch"
                  aria-checked="false"
                  aria-labelledby="setting-bold-label"
                  data-font-bold
                >
                  <span class="pill-switch-thumb" aria-hidden="true"></span>
                </button>
              </div>
              <div class="type-switch-row">
                <div class="type-switch-copy">
                  <span id="setting-scrim-label" class="type-switch-label">图示衬底</span>
                  <p id="setting-scrim-desc" class="type-switch-desc">给笔记中的图表加一层半透明底，方格背景下更易读</p>
                </div>
                <button
                  type="button"
                  class="pill-switch"
                  role="switch"
                  aria-checked="false"
                  aria-labelledby="setting-scrim-label"
                  aria-describedby="setting-scrim-desc"
                  data-svg-scrim
                >
                  <span class="pill-switch-thumb" aria-hidden="true"></span>
                </button>
              </div>
            </div>
          </details>

          <button
            class="theme-control"
            type="button"
            data-theme-cycle
            aria-label="切换主题"
            aria-describedby="theme-state"
            title="跟随系统 → 浅色 → 深色"
          >
            <svg data-theme-icon="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <rect x="3" y="4" width="18" height="13" rx="2" />
              <path d="M8 21h8m-4-4v4" />
            </svg>
            <svg data-theme-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2" />
            </svg>
            <svg data-theme-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M20 15A9 9 0 0 1 9 4a9 9 0 1 0 11 11Z" />
            </svg>
            <span id="theme-state" class="visually-hidden" role="status">
              <span data-theme-icon="system">当前主题：跟随系统</span>
              <span data-theme-icon="light">当前主题：浅色</span>
              <span data-theme-icon="dark">当前主题：深色</span>
            </span>
          </button>

          <a class="nav-gh" href={siteConfig.github} target="_blank" rel="noreferrer">GitHub ↗</a>

          <button
            type="button"
            class="mobile-menu-btn"
            id="mb"
            data-mobile-nav-toggle
            aria-expanded="false"
            aria-controls="mobile-nav-menu"
            aria-label="打开导航菜单"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <nav class="mobile-nav-menu" id="mobile-nav-menu" data-mobile-nav-menu aria-label="移动端导航" hidden>
        {navItems.map((item) => (
          <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
        ))}
        <a class="mobile-nav-ext" href={siteConfig.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </nav>
    </header>

    <script is:inline>
      (() => {
        const header = document.querySelector('.site-header');
        if (!header) return;
        const syncHeight = () => document.documentElement.style.setProperty('--header-h', `${header.getBoundingClientRect().height}px`);
        syncHeight();
        if ('ResizeObserver' in window) new ResizeObserver(syncHeight).observe(header);
        else window.addEventListener('resize', syncHeight);
      })();
    </script>

    <main id="main-content"><slot /></main>

    <footer class="site-footer">
      <div class="footer-brand">
        <strong>{siteConfig.name}</strong>
        <p>杨雨飞 · 哈尔滨工业大学 · 信息安全 · 论文精读、算法题解与 HIT 837 学习笔记。</p>
      </div>

      <div class="footer-cols" aria-label="页脚导航">
        <div class="footer-col">
          <span class="footer-col-title">归档与专题</span>
          <a href="/blog/">技术笔记</a>
          <a href="/blog/?category=Research">论文笔记</a>
          <a href="/blog/?category=Computer+Science">算法题解</a>
        </div>
        <div class="footer-col">
          <span class="footer-col-title">HIT 837 学习笔记</span>
          <a href="/study-notes/">学习笔记总览</a>
          <a href="/study-notes/837/information-security/">信息安全导论</a>
          <a href="/study-notes/837/network-security/">网络安全基础</a>
          <a href="/study-notes/837/computer-networks/">计算机网络</a>
        </div>
        <div class="footer-col">
          <span class="footer-col-title">站点与订阅</span>
          <a href="/tools/">常用工具</a>
          <a href="/about/">关于作者</a>
          <a href="/rss.xml">RSS 订阅</a>
          <a href="/sitemap.xml">Sitemap</a>
        </div>
      </div>

      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} 杨雨飞 ({siteConfig.name})</span>
        <span><a href="/rss.xml">RSS 订阅</a> <span aria-hidden="true">·</span> <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub ↗</a></span>
      </div>
    </footer>

    <script>
      import '../scripts/site-header';
      import '../scripts/typography';
      import '../scripts/site-search';
      import '../scripts/ambient-grid';
    </script>
  </body>
</html>
