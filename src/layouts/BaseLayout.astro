---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { siteConfig } from '../config';
interface Props { title?: string; description?: string; bodyClass?: string; type?: 'website' | 'article'; published?: Date; updated?: Date; noindex?: boolean }
const { title = siteConfig.title, description = siteConfig.description, bodyClass = '', type = 'website', published, updated, noindex = false } = Astro.props;
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA ?? 'local';
const path = Astro.url.pathname;
const image = new URL('/og-default.png', Astro.site);
---
<!doctype html>
<html lang="zh-CN" data-build={buildSha}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="duolaBmeng673 · 信息安全、AI 与技术笔记" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="duolaBmeng673 的笔记" href="/rss.xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let mode = 'system';
        try {
          const saved = localStorage.getItem('duolabmeng673:theme:v2') ?? localStorage.getItem('duolabmeng673:theme:v1');
          if (['light', 'dark', 'system'].includes(saved)) mode = saved;
        } catch {}
        root.dataset.themeMode = mode;
        root.dataset.theme = mode === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : mode;
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">duolaBmeng673<span aria-hidden="true">·</span></a>
        <nav class="nav" aria-label="主导航">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>首页</a>
          <a href="/blog/" aria-current={path.startsWith('/blog/') ? 'page' : undefined}>技术笔记</a>
          <a href="/study-notes/" aria-current={path.startsWith('/study-notes/') ? 'page' : undefined}>学习笔记</a>
          <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>关于</a>
        </nav>
        <div class="header-search" data-search-shell>
          <form class="header-search-form" data-search-form action="/blog/" method="get">
            <label for="header-search-input" class="visually-hidden">搜索文章</label>
            <input id="header-search-input" data-search-input type="search" name="q" placeholder="搜索全部笔记…" autocomplete="off" aria-controls="header-search-results" aria-expanded="false" />
            <kbd aria-hidden="true" data-search-shortcut>Ctrl K</kbd>
          </form>
          <div id="header-search-results" class="search-popover" data-search-popover hidden>
            <p class="search-status" data-search-status role="status">输入关键词，搜索标题、标签与正文。</p>
            <ul class="search-results" data-search-results></ul>
            <a class="search-all" data-search-all href="/blog/">查看全部结果 →</a>
          </div>
        </div>
        <div class="header-tools">
          <button class="theme-control" type="button" data-theme-cycle aria-label="切换主题" aria-describedby="theme-state" title="跟随系统 → 浅色 → 深色">
            <svg data-theme-icon="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
            <svg data-theme-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2"/></svg>
            <svg data-theme-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 15A9 9 0 0 1 9 4a9 9 0 1 0 11 11Z"/></svg>
            <span id="theme-state" class="visually-hidden" role="status"><span data-theme-icon="system">当前主题：跟随系统</span><span data-theme-icon="light">当前主题：浅色</span><span data-theme-icon="dark">当前主题：深色</span></span>
          </button>
          <details class="type-settings">
            <summary aria-label="文字设置">Aa</summary>
            <div class="type-settings-panel">
              <span class="panel-label">文字大小</span>
              <div class="type-size-options" role="group" aria-label="文字大小">
                <button type="button" data-font-size="small" aria-pressed="false">小</button>
                <button type="button" data-font-size="medium" aria-pressed="false">中</button>
                <button type="button" data-font-size="large" aria-pressed="false">大</button>
              </div>
              <label class="type-bold-toggle"><span>加粗文字</span><input type="checkbox" data-font-bold /></label>
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {siteConfig.name}</span>
      <span><a href="/rss.xml">RSS 订阅</a> <span aria-hidden="true">·</span> <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub ↗</a></span>
    </footer>
    <script>
      import '../scripts/typography';
      import '../scripts/site-search';
    </script>
  </body>
</html>
