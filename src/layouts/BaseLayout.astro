---
import '../styles/global.css';
import { siteConfig } from '../config';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  bodyClass = '',
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA ?? 'local';
---

<!doctype html>
<html lang="zh-CN" data-build={buildSha}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class={bodyClass}>
    <svg class="liquid-filter-defs" aria-hidden="true" focusable="false" width="0" height="0">
      <defs>
        <filter id="blog-liquid-glass" filterUnits="objectBoundingBox" primitiveUnits="objectBoundingBox" x="0" y="0" width="1" height="1" color-interpolation-filters="sRGB">
          <feImage id="blog-liquid-displacement-map" x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="displacement-map" />
          <feImage id="blog-liquid-specular-map" x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="specular-map" />
          <feGaussianBlur id="blog-liquid-blur" in="SourceGraphic" stdDeviation="0.01" result="blurred-source" />
          <feDisplacementMap id="blog-liquid-displacement" in="blurred-source" in2="displacement-map" scale="0.12" xChannelSelector="R" yChannelSelector="G" result="refracted" />
          <feComponentTransfer in="specular-map" result="specular-opacity"><feFuncA id="blog-liquid-specular-opacity" type="linear" slope="0.24" /></feComponentTransfer>
          <feBlend in="refracted" in2="specular-opacity" mode="screen" />
        </filter>
        <filter id="blog-liquid-glass-lite" filterUnits="objectBoundingBox" primitiveUnits="objectBoundingBox" x="0" y="0" width="1" height="1" color-interpolation-filters="sRGB">
          <feImage id="blog-liquid-lite-displacement-map" x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="displacement-map" />
          <feImage id="blog-liquid-specular-lite-map" x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="specular-map" />
          <feGaussianBlur id="blog-liquid-lite-blur" in="SourceGraphic" stdDeviation="0.005" result="blurred-source" />
          <feDisplacementMap id="blog-liquid-lite-displacement" in="blurred-source" in2="displacement-map" scale="0.12" xChannelSelector="R" yChannelSelector="G" result="refracted" />
          <feBlend in="refracted" in2="specular-map" mode="screen" />
        </filter>
      </defs>
    </svg>
    <header class="site-header">
      <a class="brand" href="/about/" aria-label="查看杨雨飞的个人主页">
        <img src="/github-avatar.png" alt="杨雨飞的 GitHub 头像" />
      </a>
      <nav class="nav" aria-label="主导航">
        <a href="/">首页</a>
        <a href="/blog/">博客</a>
        <a href="/lab/">Lab</a>
        <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {siteConfig.name}</span>
      <span>Thoughts, notes, and systems.</span>
    </footer>
    <script>
      import '../scripts/liquid-glass';
    </script>
  </body>
</html>
