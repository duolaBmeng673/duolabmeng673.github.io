---
import type { StudyModuleSummary } from '../lib/study';
interface Props { modules: StudyModuleSummary[]; headingLevel?: 'h2' | 'h3' }
const { modules, headingLevel: Heading = 'h2' } = Astro.props;
---
<div class="study-series-list" aria-label="学习模块">
  {modules.map((module) => <a class="study-series-row" data-category="Study Notes" href={module.href} data-study-module={module.slug}>
    <div class="module-head">
      <p class="note-taxonomy">考研复习 · {module.series}</p>
      <Heading class="module-title">{module.title}</Heading>
      <p class="module-desc">{module.description}</p>
    </div>
    <div class="module-metrics">
      <span class="module-metric-chip">{module.count} 篇笔记</span>
      <span class="module-metric-chip">{module.chapterCount} 个章节</span>
      <span class="module-metric-chip">{module.knowledgeTagCount} 个知识点</span>
    </div>
    <ul class="module-preview-list" aria-label={`${module.title}前四章预览`}>
      {module.previewChapters.map((ch) => (
        <li>
          <span class="preview-code">{ch.code}</span>
          <span class="preview-title">{ch.title}</span>
          <span class="preview-count">{ch.count} 篇</span>
        </li>
      ))}
    </ul>
    <span class="module-entry"><span>进入模块</span><span>→</span></span>
  </a>)}
</div>
