---
import type { Tool } from '../data/tools';
import { renderToolIcon } from '../lib/tool-icons';
interface Props { tool: Tool }
const { tool } = Astro.props;
const hostname = new URL(tool.url).hostname.replace(/^www\./, '');
const iconSvg = renderToolIcon(tool);
---
<a class="tool-card" href={tool.url} target="_blank" rel="noopener noreferrer">
  <span class="tool-mark" aria-hidden="true"><Fragment set:html={iconSvg} /></span>
  <span class="tool-card-copy"><strong>{tool.name}</strong>{tool.description && <span>{tool.description}</span>}<span class="tool-domain">{hostname}</span></span>
  <span class="tool-card-arrow" aria-hidden="true">↗</span><span class="visually-hidden">（新窗口打开）</span>
</a>
