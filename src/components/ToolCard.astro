---
import type { Tool } from '../data/tools';
interface Props { tool: Tool }
const { tool } = Astro.props;
const hostname = new URL(tool.url).hostname.replace(/^www\./, '');
---
<a class="tool-card" href={tool.url} target="_blank" rel="noopener noreferrer">
  <span class="tool-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 4h6v6m0-6L10 14m0-9H5a1 1 0 0 0-1 1v13a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1v-5" /></svg></span>
  <span class="tool-card-copy"><small>{tool.category ?? hostname}</small><strong>{tool.name}</strong>{tool.description && <span>{tool.description}</span>}<span class="tool-domain">{hostname}</span></span>
  <span class="tool-card-arrow" aria-hidden="true">↗</span><span class="visually-hidden">（新窗口打开）</span>
</a>
