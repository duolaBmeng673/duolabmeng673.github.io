---
import { activityLevel, createActivityCalendar, getActivityDayDetails, type ActivityRecord } from '../lib/activity';
import type { BlogPost } from '../lib/blog';
interface Props { posts: BlogPost[]; activities: ActivityRecord[] }
const { posts, activities } = Astro.props;
const writing: ActivityRecord[] = posts.map((post) => ({
  date: post.data.pubDate.toISOString().slice(0, 10), type: 'writing', count: 1, description: post.data.title,
}));
const data = createActivityCalendar([...activities, ...writing]);
const weekdayLabels = ['日', '一', '二', '三', '四', '五', '六'];
const monthLabels = data.columns.map((column, index) => ({
  index,
  month: column.find((day) => day?.date.endsWith('-01'))?.date.slice(5, 7),
})).filter((item) => item.month);
const selectedDay = data.columns.flat().find((day) => day?.date === data.end)!;
const selectedDetails = getActivityDayDetails(selectedDay);
---
<section class="activity-section" aria-labelledby="activity-title" data-activity-calendar data-activity-data={JSON.stringify({ activities, writing })}>
  <div class="activity-heading">
    <div><h2 id="activity-title">更新记录</h2><p class="activity-subtitle">过去一年 · 写作、研究与学习</p><p class="activity-summary" data-activity-summary>{data.activityDays} 个活跃日 · {data.totalActivities} 次活动</p></div>
    <div class="activity-legend" aria-label="活动强度图例"><span>少</span>{[0, 1, 2, 3, 4].map((level) => <i class="activity-cell" data-level={level} aria-hidden="true"></i>)}<span>多</span></div>
  </div>
  <div class="activity-scroll" tabindex="0" aria-label="过去 365 天综合技术活动日历，按星期分行、按周分列">
    <div class="activity-calendar" role="grid" aria-labelledby="activity-title" aria-rowcount="7" aria-colcount={data.columns.length} data-start={data.start} data-end={data.end}>
      <div class="activity-months" aria-hidden="true" style={`--week-count:${data.columns.length}`}><span class="activity-month-spacer"></span>{data.columns.map((_, index) => <span class="activity-month" data-column={index}>{monthLabels.find((label) => label.index === index)?.month ? `${Number(monthLabels.find((label) => label.index === index)?.month)}月` : ''}</span>)}</div>
      <div class="activity-grid">
        <div class="activity-weekdays" aria-hidden="true">{weekdayLabels.map((day, index) => <span>{index % 2 === 1 ? day : ''}</span>)}</div>
      <div class="activity-weeks">{data.columns.map((column, columnIndex) => <div class="activity-week" role="presentation">{column.map((day, rowIndex) => {
          const details = day ? getActivityDayDetails(day) : undefined;
          const level = activityLevel(day);
          const label = details?.label ?? '日期范围外';
          return <button class="activity-cell" type="button" role="gridcell" aria-rowindex={rowIndex + 1} aria-colindex={columnIndex + 1} data-date={day?.date} data-level={level} data-total={details?.total ?? 0} aria-label={label} aria-controls="activity-detail" tabindex={day?.date === data.end ? 0 : -1} disabled={!day} title={label} aria-selected={day?.date === data.end ? 'true' : 'false'}></button>;
        })}</div>)}</div>
      </div>
    </div>
  </div>
  <section class="activity-detail" id="activity-detail" role="status" aria-live="polite" aria-atomic="true" aria-labelledby="activity-detail-date">
    <div class="activity-detail-heading"><h3><time id="activity-detail-date" data-activity-detail-date datetime={selectedDay.date}>{selectedDetails.dateLabel}</time></h3><p data-activity-detail-total>{selectedDetails.total} 次活动</p></div>
    <p data-activity-detail-empty hidden={selectedDetails.total > 0}>当天没有活动。</p>
    <ul class="activity-detail-groups" data-activity-detail-groups>{selectedDetails.groups.map((group) => <li><p class="activity-detail-type">{group.label} · {group.count} 次</p>{group.descriptions.length > 0 && <ul>{group.descriptions.map((description) => <li>{description}</li>)}</ul>}</li>)}</ul>
  </section>
  <script>
    import '../scripts/activity-calendar';
  </script>
</section>

<style>
  :global(.activity-section) { padding-top: var(--space-5); }
  :global(.activity-heading) { display:flex; justify-content:space-between; align-items:end; gap:20px; margin-bottom:14px; }
  :global(.activity-heading h2) { margin:0 0 4px; font-size:1.7rem; }
  :global(.activity-subtitle) { margin:0 0 4px; color:var(--text-muted); font-size:.82rem; }
  :global(.activity-summary) { margin:0; color:var(--text-muted); font-size:.82rem; }
  :global(.activity-legend) { display:flex; align-items:center; gap:4px; color:var(--text-muted); font-size:.7rem; }
  :global(.activity-months) { display:grid; grid-template-columns:30px repeat(var(--week-count),minmax(0,1fr)); column-gap:3px; }
  :global(.activity-grid) { display:grid; grid-template-columns:30px minmax(0,1fr); gap:8px; }
  :global(.activity-months) { margin-bottom:5px; }
  :global(.activity-month-spacer) { width:30px; margin-right:5px; }
  :global(.activity-month) { min-width:0; color:var(--text-muted); font-size:.63rem; line-height:1; }
  :global(.activity-weeks) { display:grid; grid-auto-columns:minmax(0,1fr); grid-auto-flow:column; gap:3px; }
  :global(.activity-week),:global(.activity-weekdays) { display:grid; grid-template-rows:repeat(7, 13px); gap:3px; }
  :global(.activity-weekdays) { color:var(--text-muted); font-size:.58rem; line-height:13px; text-align:center; }
  :global(.activity-cell) { display:block; width:13px; height:13px; min-width:13px; min-height:13px; padding:0; border:1px solid transparent; border-radius:3px; background:var(--heat-0); }
  :global(button.activity-cell) { cursor:pointer; }
  :global(button.activity-cell:disabled) { cursor:default; }
  :global(.activity-cell[data-level="1"]) { background:var(--heat-1); }
  :global(.activity-cell[data-level="2"]) { background:var(--heat-2); }
  :global(.activity-cell[data-level="3"]) { background:var(--heat-3); }
  :global(.activity-cell[data-level="4"]) { background:var(--heat-4); }
  :global(.activity-cell[data-level="0"]) { border-color:var(--border); }
  :global(button.activity-cell:hover),:global(button.activity-cell[aria-selected="true"]) { outline:2px solid var(--text); outline-offset:1px; }
  :global(button.activity-cell:focus-visible) { outline:2px solid var(--text); outline-offset:3px; z-index:1; }
  :global(.activity-detail) { min-width:0; max-width:100%; margin:14px 0 0 38px; padding-top:10px; border-top:1px solid var(--border); color:var(--text-muted); font-size:.76rem; overflow-wrap:anywhere; }
  :global(.activity-detail-heading) { display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 12px; }
  :global(.activity-detail h3) { margin:0; color:var(--text); font-family:var(--sans); font-size:.82rem; }
  :global(.activity-detail p) { margin:0; }
  :global(.activity-detail-groups) { display:grid; gap:8px; margin:8px 0 0; padding:0; list-style:none; }
  :global(.activity-detail-type) { color:var(--text); font-weight:600; }
  :global(.activity-detail-groups ul) { margin:3px 0 0; padding-left:1.3em; }
  @media(max-width:760px) {
    :global(.activity-scroll) { max-width:calc(100vw - 64px); overflow-x:auto; padding:3px 3px 8px; scrollbar-color:var(--border-strong) transparent; }
    :global(.activity-calendar) { width:max-content; }
    :global(.activity-months) { grid-template-columns:24px repeat(var(--week-count),12px); column-gap:3px; }
    :global(.activity-grid) { grid-template-columns:24px max-content; gap:6px; }
    :global(.activity-month-spacer) { width:24px; margin-right:3px; }
    :global(.activity-week),:global(.activity-weekdays) { grid-template-rows:repeat(7, 12px); gap:3px; }
    :global(.activity-weeks) { grid-auto-columns:12px; }
    :global(.activity-weekdays) { line-height:12px; }
    :global(.activity-cell) { width:12px; height:12px; min-width:12px; min-height:12px; }
  }
  @media(max-width:520px) { :global(.activity-heading) { align-items:start; flex-direction:column; } :global(.activity-detail) { margin-left:0; } }
</style>
