---
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowledgeDirectory from './KnowledgeDirectory.astro';
import StudyNoteList from './StudyNoteList.astro';
import { getChapterHref, getStudyChapters, getStudySeries, type StudyModuleSummary } from '../lib/study';
interface Props { module: StudyModuleSummary }
const { module } = Astro.props;
const info = getStudySeries(module.series);
const chapters = getStudyChapters(module.posts);
---
<BaseLayout title={`${module.title} · ${module.series}`} description={module.description}>
  <KnowledgeDirectory posts={module.posts} showLegend={module.slug === 'information-security'}>
  <Fragment slot="intro">
  <header class="page-intro">
    <nav class="study-breadcrumb" aria-label="学习路径"><a href="/study-notes/">学习笔记</a><span>/</span><a href={`/study-notes/${info.slug}/`}>{module.series}</a><span>/</span><span aria-current="page">{module.title}</span></nav>
    <p class="eyebrow">考研复习 · {module.series}</p><h1>{module.title}</h1><p>{module.description}</p>
  </header>
  <p class="study-status">{module.count} 篇公开笔记 · 按考纲顺序浏览，不代表复习完成进度。</p>
  </Fragment>
  <div class="study-chapters" data-module-outline={module.slug}>
    {chapters.map((chapter) => <section class="study-chapter" data-knowledge-chapter>
      <header><span class="chapter-code">{chapter.code}</span><h2><a href={getChapterHref(chapter.posts[0])}>{chapter.title}</a></h2></header>
      <StudyNoteList posts={chapter.posts} chapterCode={chapter.code} />
    </section>)}
  </div>
  <p slot="footer" class="home-about-links"><a class="text-link" href={`/study-notes/${info.slug}/`}>← 返回模块选择</a><a class="text-link" href="/study-notes/">全部学习笔记 →</a></p>
  </KnowledgeDirectory>
</BaseLayout>
