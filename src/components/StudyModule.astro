---
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowledgeDirectory from './KnowledgeDirectory.astro';
import StudyNoteList from './StudyNoteList.astro';
import StudyNavBar from './StudyNavBar.astro';
import StudyQuickJumpDialog from './StudyQuickJumpDialog.astro';
import { getChapterHref, getPublicStudyNotes, getStudyChapters, getStudyModuleSummaries, getStudySeries, type StudyModuleSummary } from '../lib/study';
interface Props { module: StudyModuleSummary }
const { module } = Astro.props;
const info = getStudySeries(module.series);
const chapters = getStudyChapters(module.posts);
const allSeriesPosts = (await getPublicStudyNotes()).filter((post) => post.data.series === module.series);
const seriesModules = getStudyModuleSummaries(allSeriesPosts);
const modIdx = seriesModules.findIndex((item) => item.slug === module.slug);
const prevModule = modIdx > 0 ? seriesModules[modIdx - 1] : undefined;
const nextModule = modIdx >= 0 && modIdx + 1 < seriesModules.length ? seriesModules[modIdx + 1] : undefined;
---
<BaseLayout title={`${module.title} · ${module.series}`} description={module.description}>
  <KnowledgeDirectory posts={module.posts} showLegend={true}>
  <Fragment slot="intro">
  <header class="page-intro">
    <nav class="study-breadcrumb" aria-label="学习路径"><a href="/study-notes/">学习笔记</a><span>/</span><a href={`/study-notes/${info.slug}/`}>{module.series}</a><span>/</span><span aria-current="page">{module.title}</span></nav>
    <div class="study-intro-head">
      <h1>{module.title}</h1>
      <StudyNavBar series={module.series} currentModuleSlug={module.slug} />
    </div>
  </header>
  </Fragment>
  <div class="study-module-layout">
    <aside class="study-chapter-nav" aria-label="章节目录">
      <p class="study-chapter-nav-title">章节目录</p>
      <nav>
        {chapters.map((chapter, idx) => (
          <a href={`#chapter-${chapter.code}`} class:list={{ 'is-active': idx === 0 }} data-chapter-nav-link={`chapter-${chapter.code}`}>
            <span class="ch-nav-code">{chapter.code}</span>
            <span class="ch-nav-name">{chapter.title}</span>
            <span class="ch-nav-count">{chapter.posts.length}</span>
          </a>
        ))}
      </nav>
    </aside>
    <div class="study-chapters" data-module-outline={module.slug}>
      {chapters.map((chapter) => <section class="study-chapter" id={`chapter-${chapter.code}`} data-knowledge-chapter>
        <header>
          <span class="chapter-code">{chapter.code}</span>
          <h2><a href={getChapterHref(chapter.posts[0])}>{chapter.title}</a></h2>
          <span class="chapter-count">共 {chapter.posts.length} 篇</span>
        </header>
        <StudyNoteList posts={chapter.posts} chapterCode={chapter.code} />
      </section>)}
    </div>
  </div>
  <p slot="footer" class="home-about-links">
    {prevModule && <a class="text-link" href={prevModule.href}>← 上一模块：{prevModule.title}</a>}
    <a class="text-link" href={`/study-notes/${info.slug}/`}>← 返回模块选择</a>
    <a class="text-link" href="/study-notes/">全部学习笔记 →</a>
    {nextModule && <a class="text-link" href={nextModule.href}>下一模块：{nextModule.title} →</a>}
  </p>
  </KnowledgeDirectory>
  <StudyQuickJumpDialog series={module.series} currentModuleSlug={module.slug} />
</BaseLayout>
