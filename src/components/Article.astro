---
import { render } from 'astro:content';
import { siteConfig } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeadingText from './HeadingText.astro';
import KnowledgeChips from './KnowledgeChips.astro';
import { enrichHeadingsWithMath, normalizeTocSections, stripHeadingBadge } from '../plugins/heading-tokens.mjs';
import { getKnowledgeTags } from '../lib/knowledge-tags';
import { getBlogPosts, getPostHref, getPostTitle, taxonomyLabel, formatPostDate, type BlogPost } from '../lib/blog';
import { getChapterHref, getChapterKey, getPublicStudyNotes, getStudyChapters, getStudySeries, getStudyModuleHref, studyModules, type StudyPost } from '../lib/study';
interface Props { post: BlogPost }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const displayHeadings: typeof headings = enrichHeadingsWithMath(headings, post.body ?? '', post.data.title, post.data.shortTitle);
const sections = normalizeTocSections(displayHeadings);
const currentPostTitle = getPostTitle(post);
const study = post.collection === 'study_notes' ? post : undefined;
const knowledgeTags = study ? getKnowledgeTags(study.id) : [];
const info = study ? getStudySeries(study.data.series) : undefined;
const allStudyNotes = await getPublicStudyNotes();
const allBlogPosts = study ? [] : await getBlogPosts();
const ordered: BlogPost[] = study
  ? allStudyNotes.filter((note) => note.data.series === study.data.series)
  : allBlogPosts;
const index = ordered.findIndex((item) => item.collection === post.collection && item.id === post.id);
const previous = index > 0 ? ordered[index - 1] : undefined;
const next = index >= 0 && index + 1 < ordered.length ? ordered[index + 1] : undefined;
const prevIsCrossModule = Boolean(study && previous && previous.collection === 'study_notes' && previous.data.subject !== study.data.subject);
const nextIsCrossModule = Boolean(study && next && next.collection === 'study_notes' && next.data.subject !== study.data.subject);
const prevJumpText = previous
  ? (prevIsCrossModule && previous.collection === 'study_notes'
    ? `${studyModules[previous.data.subject].title} · 上一节`
    : (study ? '上一节' : '上一篇'))
  : '';
const prevJumpTitle = previous ? getPostTitle(previous) : '';
const nextJumpText = next
  ? (nextIsCrossModule && next.collection === 'study_notes'
    ? `下一节 · ${studyModules[next.data.subject].title}`
    : (study ? '下一节' : '下一篇'))
  : '';
const nextJumpTitle = next ? getPostTitle(next) : '';
const chapterNotes = study
  ? ordered.filter((item): item is StudyPost => item.collection === 'study_notes' && getChapterKey(item) === getChapterKey(study))
  : [];
const chapterPos = study ? chapterNotes.findIndex((item) => item.id === study.id) : -1;
const currentJumpSlug = study ? studyModules[study.data.subject].slug : 'blog';

const studyJumpModules = (['信息安全导论', '网络安全基础', '计算机网络'] as const).map((subject) => {
  const modPosts = allStudyNotes.filter((note) => note.data.subject === subject);
  const chapters = getStudyChapters(modPosts);
  return {
    slug: studyModules[subject].slug,
    title: studyModules[subject].title,
    meta: `${modPosts.length} 篇 · ${chapters.length} 章`,
    chapters: chapters.map((ch) => ({
      code: ch.code,
      title: ch.title,
      heading: `${ch.code} ${ch.title}`,
      hasActive: ch.posts.some((item) => item.collection === post.collection && item.id === post.id),
      items: ch.posts.map((item) => ({
        title: getPostTitle(item),
        href: getPostHref(item),
        active: item.collection === post.collection && item.id === post.id,
        code: item.data.syllabusSection ?? ch.code,
      })),
    })),
  };
});

const blogJumpModule = !study
  ? [{
      slug: 'blog',
      title: '技术与论文',
      meta: `${allBlogPosts.length} 篇`,
      chapters: (['Research', 'Computer Science'] as const)
        .map((cat, idx) => {
          const items = allBlogPosts
            .filter((item) => item.data.category === cat)
            .map((item) => ({
              title: getPostTitle(item),
              href: getPostHref(item),
              active: item.collection === post.collection && item.id === post.id,
              code: item.data.pubDate.toISOString().slice(5, 10),
            }));
          const title = cat === 'Research' ? '论文精读' : '算法题解';
          return {
            code: `0${idx + 1}`,
            title,
            heading: `0${idx + 1} ${title}`,
            hasActive: items.some((item) => item.active),
            items,
          };
        })
        .filter((group) => group.items.length > 0),
    }]
  : [];

const jumpModules = [...studyJumpModules, ...blogJumpModule];
// Preserve validation of legacy question metadata used by search.
for (const question of study?.data.questions ?? []) {
  const targetHeading = stripHeadingBadge(question.heading);
  const matches = headings.filter((heading) => stripHeadingBadge(heading.text) === targetHeading);
  if (matches.length !== 1) throw new Error(`Question heading must match exactly one rendered heading in ${post.id}: ${question.heading}`);
}
const canRecall = Boolean(study && headings.some((heading) => heading.depth >= 2));
---
<BaseLayout title={post.data.title} description={post.data.description} bodyClass="article-page" type="article" published={post.data.pubDate} updated={post.data.updatedDate}>
  <article class="article has-toc" data-category={post.data.category}>
    <div class="reading-progress" aria-hidden="true"></div>
    <div class="article-layout">
      <div class="article-main">
        <header class="article-header" data-category={post.data.category}>
          {study && info ? <nav class="article-taxonomy" aria-label="学习笔记路径"><a class="back-link" href={getStudyModuleHref(study)}>← 返回模块目录</a><span aria-hidden="true">/</span><a href="/study-notes/">学习笔记</a><span aria-hidden="true">/</span><a href={`/study-notes/${info.slug}/`}>{study.data.series}</a><span aria-hidden="true">/</span><a href={getStudyModuleHref(study)}>{studyModules[study.data.subject].title}</a><span aria-hidden="true">/</span><a href={getChapterHref(study)}>{study.data.syllabusChapter} {study.data.chapterTitle}</a></nav> : <nav class="article-taxonomy" aria-label="文章分类"><a class="back-link" href="/blog/">← 返回技术笔记</a><span aria-hidden="true">/</span><a href={`/blog/?category=${encodeURIComponent(post.data.category)}`}>{taxonomyLabel(post.data.category)}</a><span aria-hidden="true">·</span><a href={`/blog/?category=${encodeURIComponent(post.data.category)}&subcategory=${encodeURIComponent(post.data.subcategory)}`}>{taxonomyLabel(post.data.subcategory)}</a><span aria-hidden="true">·</span><a href={`/blog/?series=${encodeURIComponent(post.data.series)}`}>{taxonomyLabel(post.data.series)}</a></nav>}
          <div class:list={['article-title-block', { 'has-recall': canRecall }]}>
            <h1 class:list={{ 'title-long': getPostTitle(post).length > 26 }}>{getPostTitle(post)}</h1>
            {canRecall && <div class="recall-tools" data-recall-tools hidden>
              <div class="view-switch" role="group" aria-label="阅读模式"><button type="button" class="view-button is-active" data-study-mode="read" aria-pressed="true">阅读模式</button><button type="button" class="view-button" data-study-mode="recall" aria-pressed="false">背诵模式</button></div>
              <div class="view-switch recall-subbar" data-recall-actions role="group" aria-label="展开与收起控制" hidden><button type="button" class="view-button" data-recall-all="show">展开全部</button><button type="button" class="view-button" data-recall-all="hide">收起全部</button></div>
            </div>}
          </div>
          {post.data.subtitle && <p class="article-subtitle">{post.data.subtitle}</p>}
          {(!knowledgeTags.length || !study) && <p class="article-description">{post.data.description}</p>}
          <div class="article-meta-bar">
            {knowledgeTags.length && study ? <KnowledgeChips tags={knowledgeTags} href={getStudyModuleHref(study)} /> : <div class="tag-list">{post.data.tags.map((tag) => <a href={`/blog/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>}
            <div class="article-meta"><time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>{post.data.updatedDate && <><span aria-hidden="true">·</span><span>更新于 <time datetime={post.data.updatedDate.toISOString()}>{formatPostDate(post.data.updatedDate)}</time></span></>}{study?.data.syllabusSection && <><span aria-hidden="true">·</span><span>考纲 {study.data.syllabusSection}</span></>}</div>
          </div>
          {study && (
            <div class="article-quick-jump" aria-label="知识点快速跳转">
              {previous ? (
                <a class="quick-jump-pill" href={getPostHref(previous)} rel="prev" title={prevJumpTitle}>
                  ← {prevJumpText}
                </a>
              ) : (
                <span class="quick-jump-pill is-disabled" aria-disabled="true">← 已是首篇</span>
              )}
              {chapterNotes.length > 0 && (
                <details class="article-chapter-switcher" data-chapter-switcher>
                  <summary class="quick-jump-pill is-switcher">
                    <span>本章 {chapterPos >= 0 ? `${chapterPos + 1}/${chapterNotes.length}` : `${chapterNotes.length} 篇`}</span>
                    <span class="chapter-switcher-caret" aria-hidden="true">⌄</span>
                  </summary>
                  <div class="chapter-switcher-menu" role="region" aria-label="同章知识点列表">
                    <p class="chapter-switcher-head">
                      <a href={getChapterHref(study)}>{study.data.syllabusChapter} {study.data.chapterTitle}</a>
                    </p>
                    <ol class="chapter-switcher-list">
                      {chapterNotes.map((item) => (
                        <li>
                          <a href={getPostHref(item)} class:list={{ 'is-active': item.id === study.id }} aria-current={item.id === study.id ? 'page' : undefined}>
                            <span class="chapter-switcher-code">{item.data.syllabusSection ?? item.data.syllabusChapter}</span>
                            <span class="chapter-switcher-name">{item.data.shortTitle ?? item.data.title}</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </div>
                </details>
              )}
              {next ? (
                <a class="quick-jump-pill" href={getPostHref(next)} rel="next" title={nextJumpTitle}>
                  {nextJumpText} →
                </a>
              ) : (
                <span class="quick-jump-pill is-disabled" aria-disabled="true">已是末篇 →</span>
              )}
              <button type="button" class="quick-jump-pill is-action" data-article-jump-open title="快捷键 Alt + J" data-jump-shortcut-title>
                <span>笔记直达</span>
                <kbd aria-hidden="true" data-jump-shortcut data-shortcut-kind="jump">Alt J</kbd>
              </button>
            </div>
          )}
        </header>
        <button type="button" class="toc-drawer-open-btn" data-toc-drawer-open aria-controls="article-toc-drawer" aria-expanded="false" hidden>目录</button>
        <div class="article-mobile-drawers">
          {sections.length > 0 && <details class="article-toc-mobile"><summary>目录 <span aria-hidden="true">⌄</span></summary><nav aria-label="移动端文章目录"><ol>{sections.map((heading) => <li class={`toc-level-${heading.depth}`}><a href={`#${heading.slug}`}><HeadingText text={heading.text} /></a></li>)}</ol></nav></details>}
          <details class="article-nav-mobile">
            <summary>笔记直达 <span aria-hidden="true">⌄</span></summary>
            <nav aria-label="移动端笔记直达">
              {jumpModules.map((mod) => (
                <details class="mobile-jump-module" open={mod.slug === currentJumpSlug}>
                  <summary>{mod.title} <span>{mod.meta}</span></summary>
                  {mod.chapters.map((group) => (
                    <div class="article-nav-group">
                      <p class="article-nav-group-title">{group.heading}</p>
                      <ol>
                        {group.items.map((item) => (
                          <li>
                            <a href={item.href} class:list={{ 'is-active': item.active }} aria-current={item.active ? 'page' : undefined}>
                              <span class="article-nav-code">{item.code}</span>
                              <span class="article-nav-name">{item.title}</span>
                            </a>
                          </li>
                        ))}
                      </ol>
                    </div>
                  ))}
                </details>
              ))}
            </nav>
          </details>
        </div>
        <div class="article-body" data-study-body={study ? '' : undefined}><Content /></div>
        {(previous || next) && <nav class="study-pagination" aria-label={study ? '按考纲顺序浏览' : '文章上下篇'}>{previous ? <a href={getPostHref(previous)} rel="prev"><small>{study ? (prevIsCrossModule && previous.collection === 'study_notes' ? `← 上一模块（${studyModules[previous.data.subject].title}）` : '← 上一个知识点') : '← 上一篇'}</small><span>{study ? previous.data.title : getPostTitle(previous)}</span></a> : <span />}{next ? <a href={getPostHref(next)} rel="next"><small>{study ? (nextIsCrossModule && next.collection === 'study_notes' ? `下一模块（${studyModules[next.data.subject].title}） →` : '下一个知识点 →') : '下一篇 →'}</small><span>{study ? next.data.title : getPostTitle(next)}</span></a> : <span />}</nav>}
        <footer class="article-end"><a href={`${siteConfig.repository}/issues/new?${new URLSearchParams({ title: `笔记勘误：${post.data.title}`, body: `文章：${new URL(Astro.url.pathname, Astro.site).href}\n\n问题与建议：` })}`} target="_blank" rel="noreferrer">发现错误？反馈勘误 ↗</a><a href={study ? getStudyModuleHref(study) : '/blog/'}>{study ? '返回模块目录 →' : '返回技术笔记 →'}</a></footer>
      </div>
      <div class="toc-drawer-backdrop" data-toc-backdrop hidden></div>
      <aside class="article-toc" id="article-toc-drawer" aria-label="文章章节" data-toc-panel data-toc-view="toc" data-current-module={currentJumpSlug}>
        <div class="toc-header">
          <div class="toc-step-nav" role="group" aria-label={study ? '章节上下篇' : '文章上下篇'}>
            {previous ? (
              <a
                class="toc-step-btn"
                href={getPostHref(previous)}
                rel="prev"
                title={`${prevJumpText}：${prevJumpTitle}`}
                aria-label={`${prevJumpText}：${prevJumpTitle}`}
              >
                <span aria-hidden="true">←</span><span>{study ? '上一章' : '上一篇'}</span>
              </a>
            ) : (
              <span class="toc-step-btn is-disabled" role="link" aria-disabled="true" title="已是首篇" aria-label={`${study ? '上一章' : '上一篇'}：已是首篇`}>
                <span aria-hidden="true">←</span><span>{study ? '上一章' : '上一篇'}</span>
              </span>
            )}
            {next ? (
              <a
                class="toc-step-btn"
                href={getPostHref(next)}
                rel="next"
                title={`${nextJumpText}：${nextJumpTitle}`}
                aria-label={`${nextJumpText}：${nextJumpTitle}`}
              >
                <span>{study ? '下一章' : '下一篇'}</span><span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="toc-step-btn is-disabled" role="link" aria-disabled="true" title="已是末篇" aria-label={`${study ? '下一章' : '下一篇'}：已是末篇`}>
                <span>{study ? '下一章' : '下一篇'}</span><span aria-hidden="true">→</span>
              </span>
            )}
          </div>
          <div class="toc-header-actions">
            <button type="button" class="toc-jump-toggle" data-toc-jump-toggle aria-expanded="false">笔记直达</button>
            <button type="button" class="toc-drawer-close" data-toc-drawer-close aria-label="关闭目录" hidden>×</button>
          </div>
        </div>
        <div class="toc-fixed-title">
          <p class="toc-fixed-title-text" data-toc-heading data-note-title={currentPostTitle}>{currentPostTitle}</p>
          <span class="toc-fixed-title-module" data-toc-heading-module hidden></span>
        </div>
        <div class="toc-viewport" data-toc-viewport>
          <div class="toc-track" data-toc-track>
            <div class="toc-pane" data-toc-pane="toc" data-toc-scroll>
              {sections.length > 0 ? (
                <nav><ol>{sections.map((heading) => <li class={`toc-level-${heading.depth}`}><a data-toc-link href={`#${heading.slug}`}><HeadingText text={heading.text} /></a></li>)}</ol></nav>
              ) : (
                <p class="toc-empty-hint">本篇暂无二级目录，可点击上方「笔记直达」浏览全站章节。</p>
              )}
            </div>
            <div class="toc-pane" data-toc-pane="modules" data-toc-scroll aria-hidden="true">
              <p class="toc-pane-tip">选择专题模块</p>
              <div class="toc-module-list">
                {jumpModules.map((mod) => (
                  <button
                    type="button"
                    class:list={['toc-module-btn', { 'is-current': mod.slug === currentJumpSlug }]}
                    data-toc-select-module={mod.slug}
                    data-module-label={mod.title}
                  >
                    <div>
                      <strong>{mod.title}</strong>
                      <span>{mod.meta}</span>
                    </div>
                    <span class="toc-chevron" aria-hidden="true">›</span>
                  </button>
                ))}
              </div>
            </div>
            <div class="toc-pane" data-toc-pane="tree" aria-hidden="true">
              <div class="toc-chapters-toolbar">
                <div class="toc-tree-bar-head">
                  <button type="button" class="toc-back-btn" data-toc-back-modules aria-label="返回模块选择">‹ 模块</button>
                </div>
              </div>
              <div class="toc-tree-scroll" data-toc-scroll>
                {jumpModules.map((mod) => (
                  <div class="toc-chapter-panel" data-toc-module-panel={mod.slug} data-module-label={mod.title} hidden={mod.slug !== currentJumpSlug}>
                    {mod.chapters.map((ch) => (
                      <details class="toc-jump-group" open data-toc-chapter-group>
                        <summary class="toc-jump-group-title">
                          <span class="toc-jump-group-code">{ch.code}</span>
                          <span class="toc-jump-group-name">{ch.title}</span>
                          <span class="toc-jump-group-caret" aria-hidden="true">›</span>
                        </summary>
                        <ol class="toc-jump-note-list">
                          {ch.items.map((item) => (
                            <li data-toc-jump-item>
                              <a href={item.href} class:list={{ 'is-active': item.active }} aria-current={item.active ? 'page' : undefined}>
                                <span class="toc-jump-code">{item.code}</span>
                                <span class="toc-jump-name">{item.title}</span>
                              </a>
                            </li>
                          ))}
                        </ol>
                      </details>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </article>
  <script>import '../scripts/article'; import '../scripts/article-tile-bg'; import '../scripts/recall';</script>
</BaseLayout>
