---
import { getPostHref, getPostTitle, formatPostDate, taxonomyLabel, type BlogPost } from '../lib/blog';
import StudyPostRow from './StudyPostRow.astro';
interface Props { posts: BlogPost[]; grouped?: boolean }
const { posts, grouped = false } = Astro.props;
---
<div class="editorial-list">{posts.map((post) => post.collection === 'study_notes' ? <StudyPostRow post={post} grouped={grouped} /> : <a class="editorial-row" data-category={post.data.category} href={getPostHref(post)} aria-label={`阅读：${post.data.title}`}><div class="editorial-card-head"><span class="note-taxonomy">{!grouped && <>{taxonomyLabel(post.data.category)} · </>}{taxonomyLabel(post.data.series)}</span><time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time></div><div class="editorial-title"><strong>{getPostTitle(post)}</strong>{post.data.subtitle && <em>{post.data.subtitle}</em>}</div><span class="note-description">{post.data.description}</span><div class="editorial-card-foot"><span class="editorial-card-cta">阅读笔记</span><span class="row-arrow" aria-hidden="true">→</span></div></a>)}</div>
